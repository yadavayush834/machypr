{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 0,
  "exclusive": true,
  "modules-left": [
    "custom/apple",
    "custom/app",
    "custom/file",
    "custom/edit",
    "custom/view",
    "custom/window",
    "custom/help"
  ],
  "modules-center": [],
  "modules-right": [
    "custom/battery",
    "custom/network",
    "custom/search",
    "custom/control",
    "clock"
  ],
  "custom/apple": {
    "format": "\uf179",
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu apple"
  },
  "custom/app": {
    "exec": "@HOME@/.local/bin/macos-app-name",
    "return-type": "json",
    "interval": 1,
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu app"
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}",
    "on-click": "@HOME@/.local/bin/macos-menu calendar"
  },
  "custom/file": {
    "format": "File",
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu file"
  },
  "custom/edit": {
    "format": "Edit",
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu edit"
  },
  "custom/view": {
    "format": "View",
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu view"
  },
  "custom/window": {
    "format": "Window",
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu window"
  },
  "custom/help": {
    "format": "Help",
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu help"
  },
  "custom/battery": {
    "on-click": "@HOME@/.local/bin/macos-menu battery",
    "exec": "@HOME@/.local/bin/macos-status battery",
    "interval": 2,
    "return-type": "json"
  },
  "custom/network": {
    "on-click": "@HOME@/.local/bin/arch-wifi",
    "exec": "@HOME@/.local/bin/macos-status network",
    "interval": 5,
    "return-type": "json"
  },
  "custom/search": {
    "on-click": "wofi --show drun",
    "tooltip": false,
    "format": "\ue060"
  },
  "custom/control": {
    "on-click": "@HOME@/.local/bin/macos-menu control",
    "tooltip": false,
    "format": "\ue061"
  }
}
