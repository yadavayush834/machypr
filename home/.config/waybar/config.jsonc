{
  "layer": "top",
  "position": "top",
  "height": 25,
  "spacing": 0,
  "exclusive": true,
  "modules-left": [
    "custom/apple",
    "custom/app",
    "custom/file",
    "custom/edit",
    "custom/view",
    "custom/window",
    "custom/help"
  ],
  "modules-center": [],
  "modules-right": [
    "bluetooth",
    "network",
    "pulseaudio",
    "battery",
    "custom/search",
    "custom/control",
    "clock"
  ],
  "custom/apple": {
    "format": "\uf179",
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu apple"
  },
  "custom/app": {
    "exec": "@HOME@/.local/bin/macos-app-name",
    "return-type": "json",
    "interval": 1,
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu app"
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}",
    "on-click": "@HOME@/.local/bin/macos-menu calendar"
  },
  "network": {
    "format-wifi": "\uf1eb",
    "format-ethernet": "\uf1eb",
    "format-disconnected": "\udb82\udd2d",
    "tooltip-format": "{essid}",
    "on-click": "@HOME@/.local/bin/arch-wifi"
  },
  "bluetooth": {
    "format": "\uf293",
    "format-disabled": "",
    "format-off": "",
    "format-connected": "\uf293",
    "on-click": "@HOME@/.local/bin/arch-bluetooth"
  },
  "pulseaudio": {
    "format": "\uf028",
    "format-muted": "\uf6a9",
    "on-click": "pavucontrol"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% \uf240",
    "format-icons": [
      "\uf244",
      "\uf243",
      "\uf242",
      "\uf241",
      "\uf240"
    ],
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "custom/search": {
    "format": "\uf002",
    "tooltip": false,
    "on-click": "wofi --show drun"
  },
  "custom/control": {
    "format": "\uf1de",
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu control"
  },
  "custom/file": {
    "format": "File",
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu file"
  },
  "custom/edit": {
    "format": "Edit",
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu edit"
  },
  "custom/view": {
    "format": "View",
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu view"
  },
  "custom/window": {
    "format": "Window",
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu window"
  },
  "custom/help": {
    "format": "Help",
    "tooltip": false,
    "on-click": "@HOME@/.local/bin/macos-menu help"
  }
}
