[global]
always_run_script = false
font = Inter 10
width = 340
height = (0, 180)
origin = top-right
offset = (20, 65)
frame_width = 1
frame_color = "#666666"
corner_radius = 12
padding = 16
horizontal_padding = 16
separator_color = frame
[urgency_low]
background = "#242424"
foreground = "#f2f2f2"
timeout = 4
[urgency_normal]
background = "#242424"
foreground = "#f2f2f2"
timeout = 6
[urgency_critical]
background = "#242424"
foreground = "#ff6961"
frame_color = "#ff6961"
timeout = 0

[macos_effects]
summary = "*"
script = @HOME@/.local/bin/macos-notification-sound
