light=Gtk.CssProvider();light.load_from_data(b'window {background:rgba(241,241,245,0.97);border:1px solid rgba(45,45,55,0.25);border-radius:7px;color:#202024;} label,button {color:#202024;font-family:Inter;font-size:13px;} button {min-width:220px;padding:3px 9px;} button:hover,button:focus {background:#0969da;color:white;} button:hover label,button:focus label {color:white;} #battery-note {color:#66666d;font-size:11px;} .control-tile {min-width:110px;min-height:37px;background:rgba(255,255,255,0.55);border-radius:8px;padding:7px;} .control-tile label {font-size:12px;} .control-tile:focus {background:rgba(255,255,255,0.55);color:#202024;} .control-tile:focus label {color:#202024;} scale trough {min-height:14px;background:#d1d1d8;border-radius:7px;} scale highlight {background:#ffffff;border-radius:7px;} scale slider {min-width:17px;min-height:17px;background:white;border:1px solid #b8b8bd;border-radius:50%;} separator {background:rgba(40,40,50,0.16);}')
if not appearance_dark:Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(),light,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION+1)
