 def connect_network(button,network):
  global pending_action
  # iwctl's own agent handles saved credentials and secure password entry.
  pending_action=lambda:run(['kitty','--title','Connect to '+network['name'],'iwctl','station',network['device'],'connect',network['name']])
  Gtk.main_quit()
 def render_networks(result,error=None):
  if not alive[0]:return False
  refresh.set_sensitive(True)
  for child in network_rows.get_children():network_rows.remove(child)
  menu_buttons.clear()
