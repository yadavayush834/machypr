   icon=Gtk.Image.new_from_icon_name('network-wireless-signal-'+('excellent' if network['signal']>=75 else 'good' if network['signal']>=50 else 'ok' if network['signal']>=25 else 'weak')+'-symbolic',Gtk.IconSize.MENU)
   row.pack_start(icon,False,False,0)
   label=Gtk.Label(label=network['name'],xalign=0);label.set_ellipsize(3);label.set_max_width_chars(23)
   row.pack_start(label,True,True,0)
   if network['connected']:row.pack_end(Gtk.Image.new_from_icon_name('object-select-symbolic',Gtk.IconSize.MENU),False,False,0)
   if network['secure']:row.pack_end(Gtk.Image.new_from_icon_name('changes-prevent-symbolic',Gtk.IconSize.MENU),False,False,0)
   button.add(row);button.get_accessible().set_name(network['name'])
   button.connect('clicked',connect_network,network);network_rows.pack_start(button,False,False,0);menu_buttons.append(button)
  network_rows.show_all();return False
 def scan(*_,rescan=False):
  refresh.set_sensitive(False)
  def work():
   try:
    model=runpy.run_path(local('macos-wifi-model'));result=model['networks'](rescan)
    GLib.idle_add(render_networks,result)
   except Exception:
    GLib.idle_add(render_networks,{'networks':[]},'Wi-Fi unavailable. Open Wi-Fi Settings to check the service.')
  threading.Thread(target=work,daemon=True).start()
 refresh.connect('clicked',lambda *_:scan(rescan=True))
 scan(rescan=True)
 # iwd scans asynchronously; refresh the displayed results while the menu is open.
 def periodic():
  if not alive[0]:return False
  scan();return True
 GLib.timeout_add_seconds(5,periodic)

