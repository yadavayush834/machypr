def menu_key(widget,event):
 if event.keyval==Gdk.KEY_Escape:Gtk.main_quit();return True
 if menu_buttons and event.keyval in (Gdk.KEY_Up,Gdk.KEY_Down,Gdk.KEY_Home,Gdk.KEY_End):
  focused=win.get_focus();index=menu_buttons.index(focused) if focused in menu_buttons else (-1 if event.keyval==Gdk.KEY_Down else 0)
  index=0 if event.keyval==Gdk.KEY_Home else len(menu_buttons)-1 if event.keyval==Gdk.KEY_End else (index+(1 if event.keyval==Gdk.KEY_Down else -1))%len(menu_buttons)
  menu_buttons[index].grab_focus();return True
 return False
