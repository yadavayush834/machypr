if kind=='window':
 try: clients=json.loads(subprocess.check_output(['hyprctl','clients','-j']))
 except Exception:clients=[]
 def focus(w):
  if w['workspace']['name'].startswith('special:'):
   subprocess.run(['hyprctl','dispatch','hl.dsp.window.move({workspace=hl.get_active_workspace().addressable_name,window='+json.dumps('address:'+w['address'])+'})'],stdout=subprocess.DEVNULL)
  subprocess.run(['hyprctl','dispatch','hl.dsp.focus({window='+json.dumps('address:'+w['address'])+'})'],stdout=subprocess.DEVNULL)
 menus[kind]=[(w['title'][:60],lambda w=w:focus(w)) for w in clients]
battery = status_module['battery_state']() if kind == 'battery' else None
win=Gtk.Window();win.set_name('macos-menu');win.set_decorated(False);win.set_resizable(False)
GtkLayerShell.init_for_window(win);GtkLayerShell.set_namespace(win,'macos-menu');GtkLayerShell.set_layer(win,GtkLayerShell.Layer.OVERLAY)
GtkLayerShell.set_keyboard_mode(win,GtkLayerShell.KeyboardMode.EXCLUSIVE)
GtkLayerShell.set_exclusive_zone(win,-1)
