 import threading
 usage=runpy.run_path(str(home/'.local/share/codex-usage/usage.py'))
 panel=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=14);panel.set_border_width(14);panel.set_size_request(340,-1)
 heading=Gtk.Label(label='Codex Usage',xalign=0);heading.set_markup('<b>Codex Usage</b>');panel.pack_start(heading,False,False,0)
 usage_fields={}
 for duration,title in ((300,'5-hour allowance'),(10080,'Weekly allowance')):
  group=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=5)
  name=Gtk.Label(label=title,xalign=0);value=Gtk.Label(label='Reading usage…',xalign=0)
  progress=Gtk.ProgressBar();reset=Gtk.Label(label='',xalign=0);reset.set_line_wrap(True);reset.set_max_width_chars(40)
  for child in (name,value,progress,reset):group.pack_start(child,False,False,0)
  panel.pack_start(group,False,False,0);usage_fields[duration]=(value,progress,reset)
 checked=Gtk.Label(label='Checking your signed-in Codex account…',xalign=0);checked.set_line_wrap(True);checked.set_max_width_chars(40);panel.pack_start(checked,False,False,0)
 refresh_button=Gtk.Button(label='Refresh Usage');panel.pack_start(refresh_button,False,False,0)
 usage_alive=[True];usage_busy=[False]
 def render_usage(data):
  usage_busy[0]=False
  if not usage_alive[0]:return False
  refresh_button.set_sensitive(True)
  buckets=usage['windows'](data)
  for duration,(value,progress,reset) in usage_fields.items():
   window=buckets.get(duration);remaining=usage['remaining'](window)
   value.set_text(f'{100-remaining:g}% used · {remaining:g}% remaining' if remaining is not None else 'Unavailable')
   progress.set_fraction((100-remaining)/100 if remaining is not None else 0)
   reset.set_text(usage['reset_text'](window))
  fetched=data.get('fetched_at')
  message='Checked '+datetime.datetime.fromtimestamp(fetched).strftime('%H:%M:%S') if fetched else 'Usage unavailable'
  if data.get('error'):message+=' · Saved snapshot\n'+data['error'] if fetched else '\n'+data['error']
  checked.set_text(message);return False
 def refresh_usage(force=False):
  if not usage_alive[0]:return False
  if usage_busy[0]:return True
  usage_busy[0]=True;refresh_button.set_sensitive(False)
  def fetch():
   try:data=usage['snapshot'](force=force)
   except Exception as error:data={'limits':{},'error':str(error)}
   GLib.idle_add(render_usage,data)
  threading.Thread(target=fetch,daemon=True).start();return True
 refresh_button.connect('clicked',lambda _:refresh_usage(True))
 win.connect('destroy',lambda *_:usage_alive.__setitem__(0,False))
 cached=usage['load_cache']()
 if cached:render_usage(cached)
 refresh_usage();GLib.timeout_add_seconds(60,refresh_usage)
