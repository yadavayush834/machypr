def run(args):
 launcher=home/'.local/bin/macos-app-launch'
 command=[str(launcher),*args] if launcher.is_file() else args
 subprocess.Popen(command,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
def local(name):return str(home/'.local/bin'/name)
try: active=json.loads(subprocess.check_output(['hyprctl','activewindow','-j']))
except Exception:active={}
address=active.get('address','');app=active.get('class','')
def shortcut(mods,key):
 subprocess.run(['hyprctl','dispatch','hl.dsp.send_shortcut({mods='+json.dumps(mods)+',key='+json.dumps(key)+',window='+json.dumps('address:'+address)+'})'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
def launch(*args):
 if args and args[0]==local('macos-screenshot'):
  return lambda:run([args[0],*args[1:],'--delay','0.35'] if '--delay' not in args else list(args))
 return lambda:run(list(args))
