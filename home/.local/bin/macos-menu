 x=min(int(os.environ['MACOS_MENU_X']),screen-305)
 GtkLayerShell.set_margin(win,GtkLayerShell.Edge.LEFT,max(6,x))
elif kind in ('battery','control','calendar'):
 GtkLayerShell.set_anchor(win,GtkLayerShell.Edge.RIGHT,True)
 GtkLayerShell.set_margin(win,GtkLayerShell.Edge.RIGHT, {'battery':160,'control':70,'calendar':8}[kind])
else:
 GtkLayerShell.set_anchor(win,GtkLayerShell.Edge.LEFT,True)
 GtkLayerShell.set_margin(win,GtkLayerShell.Edge.LEFT,{'apple':8,'app':40,'file':125,'edit':170,'view':215,'go':260,'window':300,'help':365}.get(kind,8))
box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=1);box.set_border_width(5);win.add(box)
if kind == 'control':
 panel=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=10);panel.set_border_width(8);panel.set_size_request(270,-1)
 grid=Gtk.Grid();grid.set_row_spacing(7);grid.set_column_spacing(7)
 for index,(title,icon,command) in enumerate([('Wi-Fi','network-wireless-symbolic',[local('arch-wifi')]),('Bluetooth','bluetooth-symbolic',[local('arch-bluetooth')]),('Sound','audio-volume-high-symbolic',['pavucontrol']),('Lock Screen','system-lock-screen-symbolic',['hyprlock'])]):
  tile=Gtk.Button();tile.get_style_context().add_class('control-tile')
  inside=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,spacing=8);image=Gtk.Image.new_from_icon_name(icon,Gtk.IconSize.BUTTON);inside.pack_start(image,False,False,0);inside.pack_start(Gtk.Label(label=title),False,False,0);tile.add(inside)
  tile.connect('clicked',lambda _,command=command:(Gtk.main_quit(),run(command)))
  grid.attach(tile,index%2,index//2,1,1)
 panel.pack_start(grid,False,False,0)
 appearance_button=Gtk.Button(label='Appearance…  '+appearance_module['preference']()['mode'].title())
 appearance_button.connect('clicked',lambda _:(Gtk.main_quit(),run([local('macos-menu'),'appearance'])))
 panel.pack_start(appearance_button,False,False,0)
 sound_button=Gtk.Button(label='Sound Effects…')
 sound_button.connect('clicked',lambda _:(Gtk.main_quit(),run([local('macos-menu'),'sound-effects'])))
 panel.pack_start(sound_button,False,False,0)
 for title,initial,callback in [('Display',70,lambda value:run(['brightnessctl','set',str(round(value))+'%'])),('Sound',50,lambda value:run(['wpctl','set-volume','@DEFAULT_AUDIO_SINK@',str(round(value))+'%']))]:
  try:
   if title=='Sound':
    result=subprocess.check_output(['wpctl','get-volume','@DEFAULT_AUDIO_SINK@'],text=True,timeout=.5);initial=float(result.split()[1])*100
   else:
    now=float(subprocess.check_output(['brightnessctl','get'],text=True,timeout=.5));maximum=float(subprocess.check_output(['brightnessctl','max'],text=True,timeout=.5));initial=now/maximum*100
  except (subprocess.SubprocessError,ValueError,IndexError,FileNotFoundError):pass
  caption=Gtk.Label();caption.set_markup('<b>'+title+'</b>');caption.set_xalign(0);panel.pack_start(caption,False,False,0)
  slider=Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL,1 if title=='Display' else 0,100,1);slider.set_value(initial);slider.set_draw_value(False)
  def changed(widget,callback=callback):
   if hasattr(widget,'pending'):GLib.source_remove(widget.pending)
   def commit():callback(widget.get_value());del widget.pending;return False
   widget.pending=GLib.timeout_add(100,commit)
  from gi.repository import GLib
  slider.connect('value-changed',changed);panel.pack_start(slider,False,False,0)
 box.pack_start(panel,False,False,0)
if kind == 'calendar':
 content=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=10);content.set_border_width(8)
 today=Gtk.Label();today.set_markup('<b>'+datetime.datetime.now().strftime('%A, %B %-d')+'</b>');today.set_xalign(0);content.pack_start(today,False,False,0)
 calendar=Gtk.Calendar();calendar.set_display_options(Gtk.CalendarDisplayOptions.SHOW_HEADING|Gtk.CalendarDisplayOptions.SHOW_DAY_NAMES);calendar.mark_day(datetime.datetime.now().day);content.pack_start(calendar,False,False,0)
 box.pack_start(content,False,False,0)
if kind == 'battery':
 content=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=6);content.set_border_width(8)
 header=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,spacing=30)
 title=Gtk.Label();title.set_markup('<b>Battery</b>');title.set_xalign(0)
 percentage=Gtk.Label(label=(str(battery['capacity'])+'%') if battery['capacity'] is not None else 'Unknown')
 header.pack_start(title,True,True,0);header.pack_end(percentage,False,False,0);content.pack_start(header,False,False,2)
 source=Gtk.Label(label='Power Source: '+('Power Adapter' if battery['connected'] else 'Battery'));source.set_xalign(0)
 state=Gtk.Label(label=battery['label']);state.set_xalign(0)
 content.pack_start(source,False,False,0);content.pack_start(state,False,False,0)
 content.set_size_request(265,-1);box.pack_start(content,False,False,0)
 box.pack_start(Gtk.Separator(),False,False,5)
 details=Gtk.Label(label='Battery status updates automatically');details.set_name('battery-note');details.set_xalign(0);details.set_margin_start(8);details.set_margin_bottom(6);box.pack_start(details,False,False,0)
 def update_battery():
  current=status_module['battery_state']()
  percentage.set_text(str(current['capacity'])+'%' if current['capacity'] is not None else 'Unknown')
  source.set_text('Power Source: '+('Power Adapter' if current['connected'] else 'Battery'))
  state.set_text(current['label']);return True
 from gi.repository import GLib
 GLib.timeout_add_seconds(2,update_battery)
menu_buttons=[]
shortcuts={
 ('app','New Window'):'⌘ Return' if app=='kitty' else '⌃N',('file','New Window'):'⌘ Return' if app=='kitty' else '⌃N',
 ('app','Quit'):'⌘W',('file','Close Window'):'⌘W',('file','Open…'):'⌃O',
 ('edit','Undo'):'⌃Z',('edit','Redo'):'⇧⌃Z',('edit','Cut'):'⌃X',
 ('edit','Copy'):'⇧⌃C' if app=='kitty' else '⌃C',('edit','Paste'):'⇧⌃V' if app=='kitty' else '⌃V',('edit','Select All'):'⌃A',
 ('view','Zoom In'):'⌃+',('view','Zoom Out'):'⌃−',('view','Actual Size'):'⌃0',('apple','Lock Screen'):'⌘L'}
for item in ([] if kind in ('battery','control','calendar') else menus.get(kind,menus['apple'])):
 if item is None:box.pack_start(Gtk.Separator(),False,False,4);continue
 label,action=item
 checked=label.startswith('✓ ')
 if checked:label=label[2:]
 button=Gtk.Button();button.get_style_context().add_class('menu-row');button.get_accessible().set_name(label)
 row=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,spacing=8)
 mark=Gtk.Label(label='✓' if checked else '');mark.set_size_request(12,-1);row.pack_start(mark,False,False,0)
 text=Gtk.Label(label=label);text.set_xalign(0);row.pack_start(text,True,True,0)
 hint=Gtk.Label(label=shortcuts.get((kind,label),''));hint.get_style_context().add_class('shortcut');hint.set_xalign(1);row.pack_end(hint,False,False,0)
 button.add(row)
 def clicked(button,action=action):win.destroy();Gtk.main_quit();action()
 button.connect('clicked',clicked);box.pack_start(button,False,False,0);menu_buttons.append(button)
provider=Gtk.CssProvider();provider.load_from_data(b'#battery-note {font-size:11px;color:#bdbdc3;} label {font-family:Inter;font-size:13px;color:#f5f5f7;} window {background:rgba(38,38,42,0.98);border:1px solid #77777b;border-radius:8px;color:#f5f5f7;} button {font-family:Inter;font-size:13px;min-height:0;background:transparent;color:#f5f5f7;border:0;box-shadow:none;min-width:220px;padding:3px 10px;border-radius:4px;} button:hover,button:focus {background:#0a70df;} separator {background:#525256;min-height:1px;}')
