#!/usr/bin/env python3
"""Download original macOS wallpapers locally; apply through Hyprpaper."""
import argparse
from concurrent.futures import ThreadPoolExecutor
import json
import os
from pathlib import Path
import subprocess
import tempfile
import urllib.request

DATA = Path(__file__).absolute().parents[1] / 'share/macos-desktop/wallpapers.json'
EXTENSIONS = {'.png', '.jpg', '.jpeg', '.webp'}


def catalog(home=None):
    home = Path.home() if home is None else Path(home)
    entries = json.loads(DATA.read_text())['wallpapers']
    return [dict(e, path=str(home/'.local/share/wallpapers/macOS'/e['filename']),
                 installed=(home/'.local/share/wallpapers/macOS'/e['filename']).is_file()) for e in entries]


def download(entry, home=None):
    from PIL import Image
    home = Path.home() if home is None else Path(home)
    target = home/'.local/share/wallpapers/macOS'/entry['filename']
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.is_file():
        with Image.open(target) as image: image.verify()
        return target
    request = urllib.request.Request(entry['url'], headers={'User-Agent': 'MacHypr-Wallpapers/1.0'})
    fd, temporary = tempfile.mkstemp(prefix='.download-', dir=target.parent)
    try:
        with os.fdopen(fd, 'wb') as output, urllib.request.urlopen(request, timeout=45) as response:
            total = 0
            while chunk := response.read(256 * 1024):
                total += len(chunk)
                if total > 64 * 1024 * 1024:
                    raise ValueError('Wallpaper exceeds the 64 MiB download limit.')
                output.write(chunk)
        with Image.open(temporary) as image:
            if image.width < 1920 or image.height < 1080:
                raise ValueError('The downloaded wallpaper is not a full-resolution image.')
            image.verify()
        os.chmod(temporary, 0o644)
        os.replace(temporary, target)
        return target
    finally:
        if os.path.exists(temporary): os.unlink(temporary)


def current(home=None):
    home = Path.home() if home is None else Path(home)
    config = home/'.config/hypr/hyprpaper.conf'
    if config.exists():
        for line in config.read_text().splitlines():
            if line.strip().startswith('path ='):
                return line.split('=', 1)[1].strip()
    return ''


def apply(path, home=None, session=True):
    from PIL import Image
    home = Path.home() if home is None else Path(home)
    path = Path(path).absolute()
    if any(c in str(path) for c in ('\n', '\r', ',', '#')):
        raise ValueError('Choose a wallpaper path without commas, # or line breaks.')
    if path.suffix.lower() not in EXTENSIONS or not path.is_file():
        raise ValueError('Choose an existing PNG, JPEG or WebP image.')
    with Image.open(path) as image: image.verify()
    if session:
        result = subprocess.run(['hyprctl', 'hyprpaper', 'wallpaper', f',{path},cover'], capture_output=True, text=True, timeout=15)
        if result.returncode or 'error' in result.stdout.lower():
            raise RuntimeError(result.stderr.strip() or result.stdout.strip() or 'Hyprpaper could not apply the wallpaper.')
    config = home/'.config/hypr/hyprpaper.conf'; config.parent.mkdir(parents=True, exist_ok=True)
    temporary = config.with_suffix('.tmp')
    temporary.write_text(f'splash = false\nwallpaper {{\n monitor =\n path = {path}\n fit_mode = cover\n}}\n')
    temporary.replace(config)
    palette = home/'.local/bin/arch-palette'
    if session and palette.exists():
        subprocess.run([str(palette), str(path)], capture_output=True, timeout=45, check=True)
    return str(path)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--install', action='store_true', help='Download all 22 originals locally')
    parser.add_argument('--list', action='store_true')
    parser.add_argument('--download', metavar='ID')
    parser.add_argument('--apply', metavar='PATH')
    args = parser.parse_args()
    if args.apply: print(apply(args.apply)); return
    entries = catalog()
    if args.list: print(json.dumps(entries, indent=2)); return
    if args.download:
        entries = [e for e in entries if e['id'] == args.download]
        if not entries: parser.error('Unknown wallpaper ID')
    elif not args.install: parser.print_help(); return
    def fetch(entry):
        try: return entry['name'], str(download(entry)), None
        except Exception as error: return entry['name'], None, str(error)
    failed = []
    with ThreadPoolExecutor(max_workers=4) as pool:
        for name, path, error in pool.map(fetch, entries):
            print(('FAILED: ' + name + ': ' + error) if error else 'Installed: ' + name, flush=True)
            if error: failed.append(name)
    if failed: raise SystemExit(1)


if __name__ == '__main__': main()
