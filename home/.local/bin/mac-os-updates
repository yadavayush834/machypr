#!/usr/bin/env python3
"""Count available repository/Flatpak updates and optionally notify after login."""
import concurrent.futures
import fcntl
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time


def command(args, env=None, timeout=120):
    process = subprocess.Popen(args, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               text=True, start_new_session=True)
    try:
        output, error = process.communicate(timeout=timeout)
        return process.returncode, output.strip(), error.strip()
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGTERM)
        try:
            process.communicate(timeout=3)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.communicate()
        return 124, '', 'Update server did not respond in time.'


def arch_updates(home):
    env = dict(os.environ, LC_ALL='C', CHECKUPDATES_DB=str(home / '.cache/mac-os-updates/pacman'))
    code, output, error = command([str(home / '.local/bin/mac-os-checkupdates'), '--nocolor'], env)
    if code not in (0, 2):
        return {'source': 'Arch packages', 'count': None, 'error': error or 'Repository refresh failed.'}
    packages = [line for line in output.splitlines() if line.strip()]
    return {'source': 'Arch packages', 'count': len(packages), 'packages': packages}


def flatpak_updates(scope):
    code, output, error = command(['flatpak', 'remote-ls', '--updates', '--columns=application,arch,branch', '--' + scope], timeout=75)
    if code:
        return {'source': 'Flatpak ' + scope, 'count': None, 'error': error or 'Flatpak check failed.'}
    return {'source': 'Flatpak ' + scope, 'count': len(set(line for line in output.splitlines() if line.strip()))}


def summary(results):
    total = sum(item['count'] for item in results if item['count'] is not None)
    complete = all(item['count'] is not None for item in results)
    title = (f'{total} pending update' + ('' if total == 1 else 's')) if complete else 'Update check incomplete'
    body = '\n'.join(item['source'] + ': ' + (str(item['count']) if item['count'] is not None else 'could not check') for item in results)
    footer = 'Your software is up to date.' if complete and total == 0 else 'Official repositories and Flatpak.'
    return title, body + '\n' + footer, complete


def main():
    home = Path.home()
    state = home / '.local/state/mac-os-updates'
    state.mkdir(parents=True, exist_ok=True)
    (home / '.cache/mac-os-updates').mkdir(parents=True, exist_ok=True)
    with (state / 'check.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        with concurrent.futures.ThreadPoolExecutor(max_workers=3) as executor:
            futures = [executor.submit(arch_updates, home)]
            if __import__('shutil').which('flatpak'):
                futures.extend(executor.submit(flatpak_updates, scope) for scope in ['user', 'system'])
            results = []
            for future in futures:
                try:
                    results.append(future.result())
                except OSError as error:
                    results.append({'source': 'Package check', 'count': None, 'error': str(error)})
        title, body, complete = summary(results)
        report = {'checked_at': time.time(), 'complete': complete, 'results': results, 'notification': {'title': title, 'body': body}}
        temporary = state / 'result.tmp'
        temporary.write_text(json.dumps(report, indent=2))
        temporary.replace(state / 'result.json')
        print(title + '\n' + body, flush=True)
        if '--notify' in sys.argv:
            command(['notify-send', '--app-name=Software Updates', '--icon=system-software-update',
                     '--expire-time=15000', title, body], timeout=5)
        return 0 if complete else 1


if __name__ == '__main__':
    os.umask(0o077)
    sys.exit(main())
