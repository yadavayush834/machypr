#!/usr/bin/env bash
set -euo pipefail
mkdir -p "$HOME/Pictures/Screenshots"
region=$(slurp) || exit 0
file="$HOME/Pictures/Screenshots/$(date +%F_%H-%M-%S).png"
grim -g "$region" "$file"
"$HOME/.local/bin/macos-sound" screenshot
command -v wl-copy >/dev/null && wl-copy --type image/png < "$file"
command -v notify-send >/dev/null && notify-send 'Screenshot saved' "$file"
