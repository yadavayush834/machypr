#!/usr/bin/env python3
"""Derive a readable desktop accent from a wallpaper and refresh matching apps."""
import colorsys
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys

home = Path.home()
config = home / '.config'
state = home / '.local/state/arch-hyprland-dotfiles/palette.json'
start, end = '/* >>> wallpaper palette >>> */', '/* <<< wallpaper palette <<< */'


def command(*args):
    if shutil.which(args[0]):
        return subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    return None


def save(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)


def palette(path):
    from PIL import Image
    with Image.open(path) as image:
        image = image.convert('RGB')
        image.thumbnail((180, 180))
        reduced = image.quantize(colors=24)
        colors = sorted(reduced.getcolors(), reverse=True)
        table = reduced.getpalette()
        candidates = []
        for count, index in colors:
            rgb = tuple(table[index * 3:index * 3 + 3])
            hue, sat, val = colorsys.rgb_to_hsv(*(x / 255 for x in rgb))
            if sat > .16 and val > .12:
                candidates.append((count * (0.35 + sat) * (0.45 + val), hue, sat, val))
        if candidates:
            _, hue, sat, val = max(candidates)
        else:
            hue, sat, val = .58, .25, .65
        def hexcolor(h, s, v):
            rgb = colorsys.hsv_to_rgb(h % 1, max(0, min(s, 1)), max(0, min(v, 1)))
            return '#' + ''.join(f'{round(x * 255):02x}' for x in rgb)
        return {'accent': hexcolor(hue, min(.65, max(.30, sat)), max(.78, min(val, .92))),
                'accent2': hexcolor(hue + .075, min(.65, max(.35, sat)), .76),
                'background': hexcolor(hue, min(.38, max(.18, sat * .5)), .075),
                'surface': hexcolor(hue, min(.38, max(.18, sat * .5)), .16),
                'selection': hexcolor(hue, min(.48, max(.25, sat * .6)), .27),
                'foreground': '#e5eaf1', 'wallpaper': str(path)}


def apply(p):
    a, a2, bg, surface, selected, fg = (p[k] for k in ('accent','accent2','background','surface','selection','foreground'))
    # Appended overrides preserve the selected Waybar layout and all six styles.
    bar = config/'waybar/style.css'
    if bar.exists():
        css = bar.read_text().split(start, 1)[0].rstrip()
        save(bar, css + f'''\n\n{start}
#custom-brand {{ color: {a}; }}
#workspaces button.active {{ background: {a}; color: #10131a; }}
#clock {{ color: {a}; }}
{end}\n''')
    launcher = config/'wofi/style.css'
    if launcher.exists():
        css = launcher.read_text().split(start, 1)[0].rstrip()
        save(launcher, css + f'''\n\n{start}
window {{ background-color: {bg}; border-color: {a}; }}
#input {{ background: {surface}; color: {fg}; }}
#entry:selected {{ background: {selected}; }}
#text {{ color: {fg}; }}
{end}\n''')
    # Kitty's include is installed once; new terminals read the generated palette.
    save(config/'kitty/wallpaper-colors.conf', f'''background {bg}
foreground {fg}
selection_background {selected}
selection_foreground {fg}
cursor {a}
url_color {a}
color0 {surface}
color2 {a}
color4 {a2}
color6 {a}
color8 #78838e
color10 {a}
color12 {a2}
color14 {a}
''')
    save(config/'hypr/wallpaper-colors.lua', f'''-- Generated from the selected wallpaper.
hl.config({{general={{col={{active_border={{colors={{"rgba({a[1:]}ee)","rgba({a2[1:]}ee)"}},angle=45}}}}}}}})
''')
    dunst = config/'dunst/dunstrc'
    if dunst.exists():
        content = dunst.read_text()
        content = re.sub(r'(?m)^frame_color = "#[0-9a-fA-F]{6}"$', f'frame_color = "{a}"', content, count=1)
        save(dunst, content)
    # VS Code retains all existing settings; change only workbench colors.
    vscode = config/'Code/User/settings.json'
    if vscode.exists():
        try:
            settings = json.loads(vscode.read_text())
            custom = settings.setdefault('workbench.colorCustomizations', {})
            custom.update({'focusBorder':a, 'activityBarBadge.background':a2,
                           'activityBar.activeBorder':a, 'statusBar.background':surface,
                           'statusBar.foreground':fg, 'titleBar.activeBackground':bg,
                           'titleBar.activeForeground':fg})
            save(vscode, json.dumps(settings, indent=2)+'\n')
        except (ValueError, AttributeError, TypeError):
            print('Skipped VS Code colors: settings.json is not standard JSON.', file=sys.stderr)


def reload_apps():
    if os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):
        command('hyprctl', 'reload')
    command('pkill', '-USR2', '-u', str(os.getuid()), '-x', 'waybar')
    # Kitty reads the palette on launch; send reload to existing Kitty windows.
    command('pkill', '-USR1', '-u', str(os.getuid()), '-x', 'kitty')
    running = command('pgrep', '-u', str(os.getuid()), '-x', 'dunst')
    if running and running.returncode == 0 and shutil.which('dunst'):
        command('pkill', '-u', str(os.getuid()), '-x', 'dunst')
        subprocess.Popen(['dunst'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def main():
    args = sys.argv[1:]
    no_reload = '--no-reload' in args
    args = [arg for arg in args if arg != '--no-reload']
    if len(args) != 1:
        raise SystemExit('Usage: arch-palette WALLPAPER | --refresh [--no-reload]')
    if args[0] == '--refresh':
        if not state.exists():
            return
        p = json.loads(state.read_text())
    else:
        path = Path(args[0]).expanduser().resolve(strict=True)
        p = palette(path)
        save(state, json.dumps(p, indent=2)+'\n')
    apply(p)
    if not no_reload:
        reload_apps()
    print(f"Wallpaper palette: {p['accent']} / {p['accent2']}")


if __name__ == '__main__':
    main()
