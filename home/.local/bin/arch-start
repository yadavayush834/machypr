#!/usr/bin/env bash
export PATH="$HOME/.local/bin:$PATH"
start() { command -v "$1" >/dev/null && { pgrep -u "$UID" -x "$1" >/dev/null || "$@" >/dev/null 2>&1 & }; }
start waybar
start hyprpaper
start dunst
start hypridle
systemctl is-active --quiet NetworkManager && start nm-applet --indicator
systemctl is-active --quiet bluetooth && start blueman-applet
if command -v wl-paste >/dev/null && command -v cliphist >/dev/null && ! pgrep -u "$UID" -f '^wl-paste --watch cliphist store' >/dev/null; then
 wl-paste --watch cliphist store >/dev/null 2>&1 &
fi
if ! pgrep -u "$UID" -f '^/usr/lib/polkit-kde-authentication-agent-1' >/dev/null; then
 /usr/lib/polkit-kde-authentication-agent-1 >/dev/null 2>&1 &
fi
