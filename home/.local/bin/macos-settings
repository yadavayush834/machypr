    def page_wallpaper(self):
        current=W['current']();preview=Gtk.Image();preview.set_halign(Gtk.Align.START);self.content.pack_start(preview,False,False,0)
        if Path(current).is_file():self.thumbnail(preview,current,420,210)
        group=self.section();self.info(group,'Current Wallpaper',Path(current).stem or 'Not set')
        self.action(group,'Add Photo…',lambda *_:self.choose_photo(),button='Choose…')
        self.action(group,'Download All macOS Wallpapers',lambda b:self.work(lambda:M['command'](BIN/'macos-wallpapers','--install',timeout=600),lambda _:self.open_page('wallpaper',False),b),detail='22 original Apple wallpapers. Downloads stay on this computer.',button='Download')
        entries=W['catalog']()
        for collection in dict.fromkeys(e['collection'] for e in entries):
            self.content.pack_start(label(collection,'section-title'),False,False,0)
            flow=Gtk.FlowBox();flow.set_selection_mode(Gtk.SelectionMode.NONE);flow.set_min_children_per_line(2);flow.set_max_children_per_line(3);flow.set_column_spacing(8);flow.set_row_spacing(8);self.content.pack_start(flow,False,False,0)
            for entry in (e for e in entries if e['collection']==collection):
                button=Gtk.Button();button.get_style_context().add_class('wallpaper');button.set_tooltip_text(entry['name'])
                if entry['path']==current:button.get_style_context().add_class('selected')
                body=box(True,5);image=Gtk.Image();image.set_size_request(150,88)
                if entry['installed']:self.thumbnail(image,entry['path'],150,88)
                else:image.set_from_icon_name('folder-download-symbolic',Gtk.IconSize.DIALOG)
                body.pack_start(image,False,False,0);text=label(entry['name']+('' if entry['installed'] else ' · Download'));text.set_xalign(.5);body.pack_start(text,False,False,0);button.add(body)
                def choose(b,e=entry):
                    def apply():
                        path=W['download'](e);return W['apply'](path)
                    self.work(apply,lambda _:self.open_page('wallpaper',False),b)
                button.connect('clicked',choose);flow.add(button)
        locals_group=self.section('Your Pictures')
        self.external(locals_group,'Open Wallpaper Folder',['dolphin',str(HOME/'.local/share/wallpapers')])

    def thumbnail(self,image,path,width,height):
        image.set_size_request(width,height)
        def load():
            from PIL import Image,ImageOps
            source=Path(path)
            stamp=f'{source}:{source.stat().st_mtime_ns}:{width}:{height}'
            cache=HOME/'.cache/macos-desktop/settings-thumbnails'/(hashlib.sha256(stamp.encode()).hexdigest()+'.jpg')
            if not cache.exists():
                cache.parent.mkdir(parents=True,exist_ok=True)
                with Image.open(source) as original:
                    thumb=ImageOps.fit(ImageOps.exif_transpose(original).convert('RGB'),(width,height),method=Image.Resampling.LANCZOS)
                    temporary=cache.with_suffix('.tmp')
                    thumb.save(temporary,format='JPEG',quality=90);temporary.replace(cache)
            return GdkPixbuf.Pixbuf.new_from_file(str(cache))
        self.work(load,lambda pix:image.set_from_pixbuf(pix),image_job=True)

    def choose_photo(self):
        chooser=Gtk.FileChooserDialog(title='Choose Wallpaper',parent=self.window,action=Gtk.FileChooserAction.OPEN)
        chooser.add_buttons('Cancel',Gtk.ResponseType.CANCEL,'Set Wallpaper',Gtk.ResponseType.OK)
        filt=Gtk.FileFilter();filt.set_name('Images');[filt.add_mime_type(m) for m in ('image/jpeg','image/png','image/webp')];chooser.add_filter(filt)
        response=chooser.run();path=chooser.get_filename();chooser.destroy()
        if response==Gtk.ResponseType.OK:self.work(lambda:W['apply'](path),lambda _:self.open_page('wallpaper',False))

    def page_wifi(self):
        group=self.section();self.row(group,'Wi-Fi','Reading wireless adapter…')
        def render(data):
            for child in group.get_children():group.remove(child)
            self.toggle(group,'Wi-Fi',data['enabled'],lambda v:M['wifi_power'](v),'Manage wireless connections on this computer.')
            self.external(group,'Advanced Wi-Fi Settings',[str(BIN/'arch-wifi')])
            connected=next((n for n in data['networks'] if n['connected']),None)
            if connected:self.info(group,'Connected Network',connected['name'])
            nearby=self.section('Nearby Networks')
            if not data['networks']:self.row(nearby,'No networks found','Turn on Wi-Fi and refresh to scan again.')
            for network in data['networks']:
                if network['connected']:self.info(nearby,network['name'],'Connected');continue
                if data['backend']=='iwd':args=['iwctl','station',network['device'],'connect',network['name']]
                else:args=['nmcli','--ask','device','wifi','connect',network['name']]
                self.action(nearby,network['name'],lambda b,a=args:self.work(lambda:M['open_terminal'](a,'Connect to Wi-Fi'),widget=b),detail=('Secured' if network['secure'] else 'Open network')+f" · Signal {round(network['signal'])}%",button='Connect…')
            self.show()
        self.work(M['wifi_state'],render)

