def label(text, css=None, wrap=False):
    widget = Gtk.Label(label=str(text), xalign=0)
    widget.set_line_wrap(wrap)
    if wrap: widget.set_max_width_chars(56)
    if css: widget.get_style_context().add_class(css)
    return widget


def icon(name, size=20):
    image = Gtk.Image.new_from_icon_name(name, Gtk.IconSize.DIALOG)
    image.set_pixel_size(size)
    return image


def box(vertical=True, spacing=0):
    return Gtk.Box(orientation=Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL, spacing=spacing)


class Settings(Gtk.Application):
    __gtype_name__ = "MacHyprSettingsApplication"
    def __init__(self):
        super().__init__(application_id='org.machypr.Settings', flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.pool = ThreadPoolExecutor(max_workers=4)
        self.image_pool = ThreadPoolExecutor(max_workers=2)
        self.image_jobs = []
        self.jobs = []
        self.window = None
        self.generation = 0
        self.pending = {}
        self.history = []
        self.history_index = -1
        self.current_page = 'general'
        self.alive = True
        self.usage_timer = None
        self.connect('shutdown', self.stop)

    def stop(self, *_):
        self.alive = False
        self.stop_usage()
        self.pool.shutdown(wait=False, cancel_futures=True)
        self.image_pool.shutdown(wait=False, cancel_futures=True)

    def do_command_line(self, line):
        args = line.get_arguments()[1:]
        page = args[0].removeprefix('--page=') if args else 'general'
        if page == '--page' and len(args)>1: page=args[1]
        self.activate()
        self.open_page(page if page in {p[0] for p in PAGES} else 'general')
        return 0

    def do_activate(self):
        if self.window:
            self.window.present(); return
        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title('System Settings')
        self.window.set_icon_name('preferences-system')
        self.window.set_default_size(940, 680)
        self.window.set_size_request(820, 500)
        self.window.set_name('macos-settings')
        self.window.set_app_paintable(True)
        visual=self.window.get_screen().get_rgba_visual()
        if visual:self.window.set_visual(visual)
        self.window.connect('key-press-event', self.keys)
        root=box(False); self.window.add(root)
        sidebar=box(True,10);sidebar.set_size_request(236,-1);sidebar.get_style_context().add_class('sidebar')
        root.pack_start(sidebar,False,False,0)
        self.search=Gtk.SearchEntry(placeholder_text='Search'); self.search.set_margin_start(12);self.search.set_margin_end(12);self.search.set_margin_top(14)
        self.search.get_accessible().set_name('Search System Settings')
        sidebar.pack_start(self.search,False,False,0)
        account=Gtk.Button(); account.get_style_context().add_class('account')
        account_box=box(False,10);account_box.pack_start(icon('avatar-default',40),False,False,0)
        names=box(True,2);names.pack_start(label(getpass.getuser().capitalize(),'account-name'),False,False,0);names.pack_start(label('Local Account','muted'),False,False,0)
        account_box.pack_start(names,True,True,0);account.add(account_box);account.connect('clicked',lambda *_:self.open_page('users'))
        sidebar.pack_start(account,False,False,0)
        scroll=Gtk.ScrolledWindow();scroll.set_policy(Gtk.PolicyType.NEVER,Gtk.PolicyType.AUTOMATIC);sidebar.pack_start(scroll,True,True,0)
        self.nav=Gtk.ListBox();self.nav.set_selection_mode(Gtk.SelectionMode.SINGLE);scroll.add(self.nav)
        self.nav_rows={}
        for index,(key,title,image,color,keywords) in enumerate(PAGES):
            row=Gtk.ListBoxRow();row.key=key;row.keywords=(title+' '+keywords).casefold()
            content=box(False,9);content.set_margin_start(10);content.set_margin_end(8);content.set_margin_top(4);content.set_margin_bottom(4)
            tile=Gtk.EventBox();tile.get_style_context().add_class('nav-icon');tile.get_style_context().add_class(color);tile.add(icon(image,17))
            content.pack_start(tile,False,False,0);content.pack_start(label(title),True,True,0);row.add(content)
            if index in (0,5,14,18,23,27):row.set_margin_top(10)
            self.nav.add(row);self.nav_rows[key]=row
        self.nav.set_filter_func(lambda row:all(word in row.keywords for word in self.search.get_text().casefold().split()))
        self.nav.connect('row-activated',lambda _,row:self.open_page(row.key))
        self.nav.connect('row-selected',self.selected)
        self.search.connect('search-changed',self.search_changed)
        self.search.connect('activate',self.first_result)
        self.no_results=label('No matching settings','muted');self.no_results.set_margin_start(14);sidebar.pack_start(self.no_results,False,False,8)
        right=box(True);right.get_style_context().add_class('main');root.pack_start(right,True,True,0)
        toolbar=box(False,9);toolbar.get_style_context().add_class('toolbar')
        self.back=Gtk.Button.new_from_icon_name('go-previous-symbolic',Gtk.IconSize.MENU);self.back.set_tooltip_text('Back');self.back.connect('clicked',lambda *_:self.go(-1))
        self.forward=Gtk.Button.new_from_icon_name('go-next-symbolic',Gtk.IconSize.MENU);self.forward.set_tooltip_text('Forward');self.forward.connect('clicked',lambda *_:self.go(1))
        toolbar.pack_start(self.back,False,False,0);toolbar.pack_start(self.forward,False,False,0)
        self.title=label('General','toolbar-title');toolbar.pack_start(self.title,True,True,3)
        refresh=Gtk.Button.new_from_icon_name('view-refresh-symbolic',Gtk.IconSize.MENU);refresh.set_tooltip_text('Refresh current settings');refresh.connect('clicked',lambda *_:self.open_page(self.current_page,False));toolbar.pack_end(refresh,False,False,0)
        right.pack_start(toolbar,False,False,0)
        self.notice=Gtk.InfoBar();self.notice.set_message_type(Gtk.MessageType.ERROR);self.notice.set_show_close_button(True);self.notice.connect('response',lambda *_:self.notice.hide())
        self.notice_label=label('',wrap=True);self.notice.get_content_area().add(self.notice_label);right.pack_start(self.notice,False,False,0)
        scroller=Gtk.ScrolledWindow();scroller.set_policy(Gtk.PolicyType.NEVER,Gtk.PolicyType.AUTOMATIC);right.pack_start(scroller,True,True,0)
        self.scroller=scroller
        self.content=box(True,16);self.content.set_margin_start(28);self.content.set_margin_end(28);self.content.set_margin_top(18);self.content.set_margin_bottom(28);scroller.add(self.content)
        self.css=Gtk.CssProvider();Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(),self.css,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION+60)
        self.theme_state=None;self.theme();GLib.timeout_add_seconds(2,self.theme)
        self.glass_css=M['helper']('macos-glass')['attach']()
        self.window.show_all();self.notice.hide();self.no_results.hide();self.open_page('general')

    def theme(self):
        if not self.alive:return False
        appearance=M['helper']('macos-appearance')['current']()
        if appearance==self.theme_state:return True
        self.theme_state=appearance;dark=appearance=='dark'
        bg,side,card,fg,muted,edge=('#202022','#29292c','#2d2d30','#f5f5f7','#b5b5bd','#454548') if dark else ('#f5f5f7','#e9e9ed','#ffffff','#202024','#62626a','#d9d9df')
        self.css.load_from_data(f'''
#macos-settings {{background:{bg};color:{fg};font-family:Inter,sans-serif;font-size:13px;}}
#macos-settings label {{color:{fg};}}
#macos-settings .sidebar {{background:{side};border-right:1px solid {edge};padding-bottom:12px;}}
#macos-settings .sidebar list {{background:transparent;padding:0 10px;}}
#macos-settings .sidebar row {{border-radius:7px;padding:0;min-height:32px;}}
#macos-settings .sidebar row:selected {{background:#0a78f0;}}
#macos-settings .sidebar row:selected label {{color:white;}}
#macos-settings .nav-icon {{border-radius:6px;min-width:26px;min-height:26px;color:white;}}
#macos-settings .nav-icon image {{color:white;}}
#macos-settings .blue {{background:#1687f7;}} #macos-settings .cyan {{background:#087d9c;}}
#macos-settings .purple {{background:#8c56dc;}} #macos-settings .red {{background:#df424b;}}
#macos-settings .green {{background:#288b47;}} #macos-settings .gray {{background:#707078;}}
#macos-settings .account {{background:transparent;border:0;box-shadow:none;margin:0 10px;padding:8px 5px;}}
#macos-settings .account-name {{font-size:16px;font-weight:600;}}
#macos-settings .toolbar {{padding:12px 18px;border-bottom:1px solid {edge};min-height:28px;}}
#macos-settings .toolbar button {{padding:4px;min-width:22px;min-height:22px;background:transparent;border:0;box-shadow:none;}}
#macos-settings .toolbar-title {{font-size:16px;font-weight:600;}}
#macos-settings .page-title {{font-size:22px;font-weight:600;margin-top:4px;}}
#macos-settings .section-title {{font-size:13px;font-weight:600;margin:9px 2px 0;}}
#macos-settings .muted {{color:{muted};font-size:12px;}}
#macos-settings .group {{background:{card};border:1px solid {edge};border-radius:10px;}}
#macos-settings .setting-row {{padding:11px 13px;min-height:26px;}}
#macos-settings .setting-row + .setting-row {{border-top:1px solid {edge};}}
#macos-settings .setting-row button {{padding:3px 9px;}}
#macos-settings .setting-row switch {{margin:0;}}
#macos-settings button {{border-radius:6px;}}
#macos-settings button:focus, #macos-settings entry:focus {{outline:2px solid #1687f7;outline-offset:1px;}}
#macos-settings .wallpaper {{padding:4px;background:transparent;border:2px solid transparent;box-shadow:none;border-radius:9px;}}
#macos-settings .wallpaper.selected {{border-color:#1687f7;}}
#macos-settings .wallpaper label {{font-size:11px;}}
#macos-settings .appearance {{padding:8px;background:{card};border:1px solid {edge};border-radius:9px;}}
#macos-settings .appearance.selected {{border:2px solid #1687f7;padding:7px;}}
#macos-settings .page-icon {{border-radius:14px;min-width:58px;min-height:58px;color:white;}}
#macos-settings .page-icon image {{color:white;}}
#macos-settings scale {{min-width:170px;}}
#macos-settings scale value {{color:{fg};}}
#macos-settings entry {{min-height:25px;}}
'''.encode());return True

    def selected(self,_,row):
        if row and row.key!=self.current_page:self.open_page(row.key)

    def search_changed(self,*_):
        self.nav.invalidate_filter();query=self.search.get_text().casefold().split()
        visible=any(all(w in row.keywords for w in query) for row in self.nav_rows.values())
        self.no_results.set_visible(not visible)

    def first_result(self,*_):
        words=self.search.get_text().casefold().split()
        row=next((r for r in self.nav_rows.values() if all(w in r.keywords for w in words)),None)
        if row:self.open_page(row.key)

    def keys(self,_,event):
        if event.state&Gdk.ModifierType.CONTROL_MASK and event.keyval in (Gdk.KEY_f,Gdk.KEY_F):self.search.grab_focus();return True
        if event.state&Gdk.ModifierType.MOD1_MASK and event.keyval in (Gdk.KEY_Left,Gdk.KEY_Right):self.go(-1 if event.keyval==Gdk.KEY_Left else 1);return True
        if event.keyval==Gdk.KEY_Escape and self.search.get_text():self.search.set_text('');return True
        return False

    def go(self,delta):
        target=self.history_index+delta
        if 0<=target<len(self.history):self.history_index=target;self.open_page(self.history[target],False)

    def error(self,error):
        self.notice_label.set_text(str(error));self.notice.show_all()

    def work(self,operation,done=None,widget=None,page_bound=True,image_job=False):
        generation=self.generation
        if widget:widget.set_sensitive(False)
        future=(self.image_pool if image_job else self.pool).submit(operation)
        self.jobs.append((generation,future))
        if image_job:self.image_jobs.append(future)
        def finish():
            self.jobs=[(g,f) for g,f in self.jobs if f is not future]
            if not self.alive or future.cancelled():return False
            if widget:widget.set_sensitive(True)
            try:
                value=future.result()
                if done and (not page_bound or generation==self.generation):done(value)
            except Exception as error:
                if not page_bound or generation==self.generation:self.error(error)
                if widget and isinstance(widget,Gtk.Switch) and hasattr(widget,'original'):widget.set_active(widget.original)
            return False
        future.add_done_callback(lambda *_:GLib.idle_add(finish))
        return future

    def section(self,title=None):
        if title:self.content.pack_start(label(title,'section-title'),False,False,0)
        group=box();group.get_style_context().add_class('group');self.content.pack_start(group,False,False,0);return group

    def row(self,group,title,detail=None,control=None):
        row=box(False,14);row.get_style_context().add_class('setting-row')
        text=box(True,3);name=label(title,wrap=True);text.pack_start(name,False,False,0)
        if detail:text.pack_start(label(detail,'muted',True),False,False,0)
        row.pack_start(text,True,True,0)
        if control:row.pack_end(control,False,False,0)
        group.pack_start(row,False,False,0);return row

    def info(self,group,title,value):
        value_label=label(value,'muted');value_label.set_line_wrap(True);value_label.set_max_width_chars(28);value_label.set_xalign(1)
        self.row(group,title,control=value_label)

    def action(self,group,title,callback,detail=None,button='Open…',available=True):
        control=Gtk.Button(label=button);control.set_sensitive(available)
        control.connect('clicked',lambda *_:callback(control));self.row(group,title,detail,control);return control

    def external(self,group,title,args,detail=None,terminal=False):
        exists=bool(shutil.which(args[0]) or Path(args[0]).is_file())
        missing=args[0]
        if args[:2]==['flatpak','run'] and len(args)>2:
            try:exists=Gio.DesktopAppInfo.new(args[2]+'.desktop') is not None
            except TypeError:exists=False
            missing=args[2]
        self.action(group,title,lambda b:self.work(lambda:M['open_terminal'](args,title) if terminal else M['launch'](args),widget=b),detail if exists else f'{missing} is not installed.',available=exists)

    def toggle(self,group,title,value,operation,detail=None):
        switch=Gtk.Switch();switch.set_valign(Gtk.Align.CENTER);switch.set_active(bool(value));switch.original=bool(value)
        def change(widget,state):
            if state==widget.original:return False
            def success(_):widget.original=state;widget.set_active(state)
            self.work(lambda:operation(state),success,widget)
            return True
        switch.connect('state-set',change);self.row(group,title,detail,switch);return switch

    def scale(self,group,title,value,minimum,maximum,operation,step=1,detail=None):
        control=Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL,minimum,maximum,step);control.set_value(value);control.set_digits(0 if step>=1 else 2);control.set_size_request(185,-1)
        token=[None]
        def changed(widget):
            if token[0]:GLib.source_remove(token[0])
            def apply():
                token[0]=None
                self.work(lambda:operation(widget.get_value()))
                return False
            token[0]=GLib.timeout_add(250,apply)
        control.connect('value-changed',changed);self.row(group,title,detail,control);return control

    def choice(self,group,title,options,current,operation,detail=None):
        control=Gtk.ComboBoxText()
        for key,text in options:control.append(str(key),text)
        control.set_active_id(str(current))
        control.connect('changed',lambda c:self.work(lambda:operation(c.get_active_id()),widget=c) if c.get_active_id() is not None else None)
        self.row(group,title,detail,control);return control

    def show(self):self.content.show_all()

    def open_page(self,page,remember=True):
        if not self.window:return
        self.stop_usage()
        if remember and (self.history_index<0 or self.history[self.history_index]!=page):
            self.history=self.history[:self.history_index+1]+[page];self.history_index=len(self.history)-1
        # Opening, refreshing and history navigation all start at the page top.
        self.scroller.get_vadjustment().set_value(0)
        self.current_page=page;self.generation+=1;self.notice.hide()
        for future in self.image_jobs:future.cancel()
        self.image_jobs=[]
        for child in self.content.get_children():self.content.remove(child)
        spec=next(p for p in PAGES if p[0]==page);self.title.set_text(spec[1]);self.nav.select_row(self.nav_rows[page])
        self.back.set_sensitive(self.history_index>0);self.forward.set_sensitive(self.history_index<len(self.history)-1)
        title=label(spec[1],'page-title');self.content.pack_start(title,False,False,0)
        try:getattr(self,'page_'+page)()
        except Exception as error:self.error(error)
        self.show()
        generation=self.generation
        def top():
            if generation==self.generation:self.scroller.get_vadjustment().set_value(0)
            return False
        GLib.idle_add(top)

    def options(self,names,render):
        loading=label('Reading current settings…','muted');self.content.pack_start(loading,False,False,0)
        def read():
            values={}
            for name in names:
                try:values[name]=M['option'](M['OPTIONS'][name][0])
                except Exception:values[name]=None
            return values
        def done(values):self.content.remove(loading);render(values);self.show()
        self.work(read,done)

    def hypr_switch(self,group,title,key,values,detail=None,invert=False):
        if values.get(key) is None:self.info(group,title,'Unavailable');return
        self.toggle(group,title,not values[key] if invert else values[key],lambda v:M['set_option'](key,not v if invert else v),detail)

    def page_general(self):
        self.content.pack_start(label('Manage this computer, software, storage and everyday system preferences.','muted',True),False,False,0)
        self.live_usage()
        group=self.section()
        for title,detail,method in [('About','Hardware and software information',self.about),('Software Update','Arch packages and Flatpak applications',self.updates),('Storage','Available space and home folder',self.storage),('Date & Time','Time zone and network time',self.datetime_page),('Language & Region','System locale and keyboard layout',self.language),('Login Items & Extensions','Apps and services that start at login',self.login_items),('Sharing','Network services and computer name',self.sharing),('Time Machine','Backups and restore on Linux',self.backups)]:
            self.action(group,title,lambda b,m=method:self.subpage(m),detail,button='›')

    def subpage(self,method):
        self.stop_usage();self.generation+=1
        for child in self.content.get_children():self.content.remove(child)
        control=Gtk.Button(label='Back to General');control.set_halign(Gtk.Align.START);control.connect('clicked',lambda *_:self.open_page('general',False));self.content.pack_start(control,False,False,0)
        method();self.show()

    def about(self):
        self.content.pack_start(icon('computer',72),False,False,8);self.content.pack_start(label('About This Computer','page-title'),False,False,0)
        def render(info):
            group=self.section();self.info(group,'Computer Name',info['hostname']);self.info(group,'Operating System',info['system']);self.info(group,'Kernel',info['kernel']);self.info(group,'Processor',info['cpu']);self.info(group,'Memory',str(info['memory'])+' GB');self.show()
        self.work(M['system_info'],render)
        self.live_usage()

    def stop_usage(self):
        if self.usage_timer is not None:
            GLib.source_remove(self.usage_timer);self.usage_timer=None

    def live_usage(self,storage_only=False):
        self.stop_usage()
        group=self.section('Live Usage')
        fields={}
        for key,title in ([('storage','Storage')] if storage_only else [('ram','RAM'),('storage','Storage')]):
            content=box(True,5);content.set_margin_start(14);content.set_margin_end(14);content.set_margin_top(10);content.set_margin_bottom(10)
            content.pack_start(label(title),False,False,0)
            summary=label('Reading current usage…',wrap=True);content.pack_start(summary,False,False,0)
            exact=label('','muted',True);exact.set_selectable(True);content.pack_start(exact,False,False,0)
            group.pack_start(content,False,False,0);fields[key]=(summary,exact)
        explanation='Storage covers the filesystem containing your home folder.'
        if not storage_only:explanation='RAM used = total − available (reclaimable cache is available). '+explanation
        note=label('Refreshes every second. '+explanation,'muted',True)
        self.content.pack_start(note,False,False,0)
        generation=self.generation;busy=[False]
        def read():
            try:return M['resource_usage'](),None
            except Exception as error:return None,str(error)
        def render(result):
            busy[0]=False
            data,error=result
            for key,(summary,exact) in fields.items():
                if error:
                    summary.set_text('Current usage unavailable');exact.set_text(error);continue
                values=data[key];used,total,available=(values[k] for k in ('used','total','available'))
                percent=100*used/total if total else 0
                summary.set_text(f'{used/2**30:.3f} / {total/2**30:.3f} GiB used · {percent:.2f}%')
                exact.set_text(f'Used: {used:,} bytes\nAvailable: {available:,} bytes\nTotal: {total:,} bytes')
                if key=='storage':summary.set_tooltip_text(data['storage_path'])
        def refresh():
            if not self.alive or generation!=self.generation:return False
            if not busy[0]:busy[0]=True;self.work(read,render)
            return True
        refresh();self.usage_timer=GLib.timeout_add_seconds(1,refresh)

