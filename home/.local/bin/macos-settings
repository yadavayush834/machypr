    def page_performance(self):
        self.content.pack_start(label('Choose how this computer balances speed, battery life and heat. Profiles change CPU policy and foreground CPU/I/O priorities.','muted',True),False,False,0)
        profiles=self.section('Power Profile');buttons={};applying=[False]
        descriptions={
            'battery-saver':('Battery Saver','Lower CPU/GPU ceilings, turbo off, energy-first CPU policy. Optional cache warmup is deferred.'),
            'standard':('Standard (Balanced)','Responsive everyday use with adaptive CPU frequency, turbo available and normal hardware thermal management.'),
            'performance':('Performance','Performance-first CPU policy, turbo, dynamic boost and full supported GPU ceiling. Highest foreground CPU/I/O priority. More heat and fan noise are expected.'),
        }
        def change(profile):
            applying[0]=True
            for button in buttons.values():button.set_sensitive(False)
            def apply():
                try:return M['command'](BIN/'macos-power-profile','--set',profile,timeout=180),None
                except Exception as error:return None,str(error)
            def done(result):
                applying[0]=False
                if result[1]:self.error(result[1])
                refresh()
            self.work(apply,done)
        for key,(title,detail) in descriptions.items():
            buttons[key]=self.action(profiles,title,lambda _,key=key:change(key),detail,button='Select')
        setup=self.section('Hardware Controls')
        message=label('Reading applied settings…','muted',True);setup.pack_start(message,False,False,12)
        install=self.action(setup,'Enable Hardware Profiles',lambda button:self.work(lambda:M['command'](BIN/'macos-power-profile','--install',timeout=180),lambda _:self.open_page('performance',False),button),'Administrator authentication installs the CPU/GPU controller and saves your original hardware settings.',button='Enable…')
        telemetry=self.section('Applied Settings');values={}
        for name in ('Active Profile','CPU Policy','Energy Preference','Turbo','Dynamic Boost','CPU Performance Ceiling','CPU Temperature','Controller','Foreground Scheduling'):
            value=label('Reading…','muted');value.set_line_wrap(True);value.set_max_width_chars(28);value.set_xalign(1);self.row(telemetry,name,control=value);values[name]=value
        self.content.pack_start(label('Performance uses the hardware’s supported limits. Thermal feedback lowers the CPU ceiling when cooling is saturated and restores it as temperatures fall. It does not change animations. RAM overclocking and unlocked CPU ratios are not available on this laptop.','muted',True),False,False,0)
        restore=self.section()
        self.action(restore,'Restore Original Hardware Settings',lambda button:self.work(lambda:M['command'](BIN/'macos-power-profile','--restore',timeout=180),lambda _:self.open_page('performance',False),button),'Stops the profile controller and restores the saved CPU/GPU values.',button='Restore…')
        generation=self.generation;busy=[False]
        def read():
            data=json.loads(M['command'](BIN/'macos-power-profile','--status'))
            data['service']=subprocess.run(['systemctl','is-active','--quiet','macos-power-profiles.service'],timeout=3).returncode==0
            path=Path(os.environ.get('XDG_RUNTIME_DIR',f'/run/user/{os.getuid()}'))/'macos-responsiveness/status.json'
            try:data['foreground']=json.loads(path.read_text())
            except (OSError,ValueError):data['foreground']={}
            return data
        def render(data):
            busy[0]=False;profile=data['selected']
            for key,button in buttons.items():button.set_label('Selected' if key==profile else 'Select');button.set_sensitive(not applying[0] and data['installed'] and data['supported'] and key!=profile)
            install.set_sensitive(data['supported']);install.set_label('Reinstall…' if data['installed'] else 'Enable…')
            message.set_text(('Hardware profiles enabled. Switching profiles requests administrator authentication.' if data['installed'] else 'Hardware profiles need administrator authentication before CPU/GPU settings can change.') if data['supported'] else 'These hardware profiles require active Intel P-state support; this machine uses another driver.')
            policy=data['policies'];governors=sorted({str(p['governor']) for p in policy});epp=sorted({str(p['epp']) for p in policy})
            values['Active Profile'].set_text(descriptions[profile][0] if profile in descriptions else 'Current system settings')
            values['CPU Policy'].set_text(', '.join(governors));values['Energy Preference'].set_text(', '.join(epp))
            values['Turbo'].set_text('Enabled' if data['turbo'] else 'Disabled');values['Dynamic Boost'].set_text('Enabled' if data['dynamic_boost']=='1' else 'Disabled' if data['dynamic_boost']=='0' else 'Not supported')
            values['CPU Performance Ceiling'].set_text(str(data['cpu_limit_percent'])+'%');values['CPU Temperature'].set_text(f"{data['temperature']:.1f}°C" if data['temperature'] is not None else 'Unavailable')
            report=data['controller'];fresh=time_now()-report.get('updated',0)<15
            values['Controller'].set_text(report.get('error') or ('Running' if data['service'] and fresh else 'Stopped'))
            fg=data['foreground'];values['Foreground Scheduling'].set_text(f"CPU weight {fg.get('cpu_weight',300)} · I/O weight {fg.get('io_weight',100)}" if fg.get('running') else 'Priority service stopped')
        def time_now():
            import time
            return time.time()
        def refresh():
            if not self.alive or generation!=self.generation:return False
            if not busy[0] and not applying[0]:busy[0]=True;self.work(read,render)
            return True
        refresh();self.usage_timer=GLib.timeout_add_seconds(3,refresh)

