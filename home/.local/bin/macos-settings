    def page_displays(self):
        group=self.section()
        self.work(M['brightness'],lambda value:(self.scale(group,'Brightness',value,1,100,lambda v:M['command']('brightnessctl','set',str(round(v))+'%')),self.show()))
        def render(raw):
            for monitor in json.loads(raw):
                panel=self.section(monitor.get('description',monitor['name']))
                self.info(panel,'Resolution',f"{monitor['width']} × {monitor['height']}");self.info(panel,'Refresh Rate',f"{monitor['refreshRate']:.1f} Hz")
                self.info(panel,'Display Scaling',f"{monitor['scale']:g}×")
                modes=[m.removesuffix('Hz') for m in monitor.get('availableModes',[])]
                active=f"{monitor['width']}x{monitor['height']}@{monitor['refreshRate']:.2f}"
                if modes:
                    if active not in modes:active=modes[0]
                    self.choice(panel,'Resolution',[(m,m.replace('x',' × ').replace('@',' · ')+' Hz') for m in modes],active,lambda v,m=monitor:self.change_scale(dict(m,requested_mode=v),m['scale']))
                self.choice(panel,'Scale',[(str(v),str(v)+'×') for v in (1,1.25,1.5,1.75,2)],str(monitor['scale']).removesuffix('.0'),lambda v,m=monitor:self.change_scale(m,float(v)),detail='A 15-second confirmation protects against unreadable settings.')
            self.show()
        self.work(lambda:M['command']('hyprctl','monitors','-j'),render)

    def change_scale(self,monitor,value):
        # Monitor changes run on the GTK thread, so the confirmation remains usable.
        GLib.idle_add(self.confirm_scale,monitor,value)

    def confirm_scale(self,monitor,value):
        name=monitor['name'];old=monitor['scale']
        old_mode=f"{monitor['width']}x{monitor['height']}@{monitor['refreshRate']:.2f}"
        new_mode=monitor.get('requested_mode',old_mode)
        # Build Lua explicitly; JSON object syntax is not Lua syntax.
        def lua_apply(scale,mode):
            result=M['command']('hyprctl','eval',f'hl.monitor({{output={json.dumps(name)},mode={json.dumps(mode)},position="auto",scale={scale}}})')
            if 'error' in result.lower():raise RuntimeError(result)
        try:lua_apply(value,new_mode)
        except Exception as error:self.error(error);return False
        dialog=Gtk.MessageDialog(transient_for=self.window,modal=True,message_type=Gtk.MessageType.QUESTION,buttons=Gtk.ButtonsType.NONE,text='Keep these display settings?')
        dialog.add_buttons('Revert',Gtk.ResponseType.CANCEL,'Keep Changes',Gtk.ResponseType.OK)
        dialog.format_secondary_text('The previous scale will be restored in 15 seconds.')
        token=GLib.timeout_add_seconds(15,lambda:(dialog.response(Gtk.ResponseType.CANCEL),False)[1])
        response=dialog.run();dialog.destroy();GLib.source_remove(token)
        try:
            if response!=Gtk.ResponseType.OK:lua_apply(old,old_mode)
            else:
                config=HOME/'.config/hypr/display-settings.lua';config.parent.mkdir(parents=True,exist_ok=True)
                settings=M['read_json'](HOME/'.config/macos-desktop/displays.json');settings[name]={'scale':value,'mode':new_mode}
                M['atomic_json'](HOME/'.config/macos-desktop/displays.json',settings)
                config.write_text(''.join(f'hl.monitor({{output={json.dumps(n)},mode={json.dumps(s["mode"])},position="auto",scale={s["scale"]}}})\n' for n,s in settings.items()))
        except Exception as error:self.error(error)
        self.open_page('displays',False);return False

    def page_lock(self):
        group=self.section();timeout=M['lock_timeout']()
        if timeout is not None:self.choice(group,'Start Screen Lock When Inactive',[(str(v),str(v//60)+' minutes') for v in (60,120,300,600,900,1800,3600)],str(timeout),lambda v:M['set_lock_timeout'](int(v)))
        else:self.row(group,'Automatic Lock','No loginctl lock listener found in hypridle.conf.')
        self.external(group,'Lock Now',['hyprlock']);self.row(group,'Require Password','Your account password is required immediately after locking.');self.action(group,'Change Login Password',lambda *_:self.open_page('password'))

    def page_screensaver(self):
        self.content.pack_start(label('This desktop uses a secure idle lock with your wallpaper. macOS aerial video screen savers are not installed.','muted',True),False,False,0)
        self.page_lock();self.action(self.section(),'Choose Wallpaper',lambda *_:self.open_page('wallpaper'))

