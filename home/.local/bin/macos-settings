        self.action(group,'Notification Sound',lambda *_:self.open_page('sound'))

    def page_focus(self):
        group=self.section('Do Not Disturb')
        def render(raw):self.toggle(group,'Do Not Disturb',raw=='true',lambda v:M['command']('dunstctl','set-paused','true' if v else 'false'),'Pause notification banners until you turn this off.');self.show()
        self.work(lambda:M['command']('dunstctl','is-paused'),render)
        self.row(group,'Calls and Messages','Do Not Disturb controls desktop notifications. Individual apps manage their own calls and alerts.')

    def page_screentime(self):
        S=SCREEN_TIME;days=getattr(self,'screen_days',1);offset=getattr(self,'screen_offset',0)
        controls=self.section()
        def period(value):
            self.screen_days=int(value);self.screen_offset=0;self.open_page('screentime',False)
        view=Gtk.ComboBoxText();view.append('1','Day');view.append('7','Week');view.set_active_id(str(days))
        view.connect('changed',lambda widget:period(widget.get_active_id()))
        self.row(controls,'View',control=view)
        navigation=box(False,8)
        def move(delta):
            self.screen_offset=max(0,offset+delta*days);self.open_page('screentime',False)
        previous=Gtk.Button(label='Previous');previous.connect('clicked',lambda *_:move(1));navigation.pack_start(previous,False,False,0)
        next_button=Gtk.Button(label='Next');next_button.set_sensitive(offset>0);next_button.connect('clicked',lambda *_:move(-1));navigation.pack_start(next_button,False,False,0)
        self.content.pack_start(navigation,False,False,0)
        date_label=label('Loading history…','muted');self.content.pack_start(date_label,False,False,0)
        total=label('','page-title');self.content.pack_start(total,False,False,0)
        chart=Gtk.DrawingArea();chart.set_size_request(-1,130);chart_values=[[]]
        def draw(widget,cr):
            values=chart_values[0]
            if not values:return False
            width=widget.get_allocated_width();height=widget.get_allocated_height();maximum=max(60,max(v for _,v in values))
            slot=width/len(values)
            for index,(caption,value) in enumerate(values):
                bar=(height-30)*value/maximum
                cr.set_source_rgb(.12,.49,.91);cr.rectangle(index*slot+4,height-25-bar,max(2,slot-8),bar);cr.fill()
                cr.set_source_rgb(*((.75,.75,.8) if self.theme_state=='dark' else (.3,.3,.35)))
                cr.set_font_size(10);cr.move_to(index*slot+3,height-8);cr.show_text(caption)
            return False
        chart.connect('draw',draw);chart.get_accessible().set_name('Screen Time usage chart');self.content.pack_start(chart,False,False,0)
        app_group=self.section('App Usage');app_rows={};app_empty=label('No usage recorded for this period. History starts when tracking is enabled.','muted',True);app_group.pack_start(app_empty,False,False,12)
        preferences=self.section('Tracking')
        pause=Gtk.Switch();self.row(preferences,'Pause Tracking','History stays on this computer. Only app identifiers and durations are saved.',pause)
        pause_handler=pause.connect('state-set',lambda widget,value:(self.work(lambda:S.configure('paused',value)),False)[1])
        state=label('Checking tracking service…','muted',True);self.content.pack_start(state,False,False,0)
        self.content.pack_start(label('Idle time after 60 seconds, locked time and sleep are excluded. Daily limits send a reminder; apps remain usable. App totals count foreground use, not background processes.','muted',True),False,False,0)
        def clear_history(_):
            dialog=Gtk.MessageDialog(transient_for=self.window,modal=True,message_type=Gtk.MessageType.QUESTION,buttons=Gtk.ButtonsType.OK_CANCEL,text='Clear Screen Time history?')
            dialog.format_secondary_text('All recorded app usage will be deleted. Your tracking preferences and daily reminders are kept.')
            response=dialog.run();dialog.destroy()
            if response==Gtk.ResponseType.OK:self.work(S.clear,lambda _:self.open_page('screentime',False))
        self.action(preferences,'Clear Usage History',clear_history,button='Clear…')
        generation=self.generation;busy=[False]
        def read():
            data=S.summary(days,offset)
            data['service']=subprocess.run(['systemctl','--user','is-active','--quiet','macos-screen-time.service'],timeout=3).returncode==0
            return data
        def render(data):
            busy[0]=False;date_label.set_text(data['start'] if days==1 else data['start']+' – '+data['end'])
            total.set_text(S.duration(data['total'])+' active use')
            chart_values[0]=[(f'{hour:02}',data['hours'].get(hour,0)) for hour in range(24)] if days==1 else [(datetime.date.fromisoformat(day).strftime('%a'),data['daily'].get(day,0)) for day in [(datetime.date.fromisoformat(data['start'])+datetime.timedelta(days=i)).isoformat() for i in range(7)]]
            chart.queue_draw();pause.handler_block(pause_handler);pause.set_active(data['paused']);pause.handler_unblock(pause_handler)
            state.set_text(('Tracking paused' if data['paused'] else 'Tracking active') if data['service'] else 'Tracking service is stopped. Reopen your desktop session or start macos-screen-time.service.')
            current={app for app,_ in data['apps']}
            for app in set(app_rows)-current:
                app_group.remove(app_rows.pop(app)[0])
            app_empty.set_visible(not data['apps'])
            for app,seconds in data['apps']:
                if app not in app_rows:
                    value=label('','muted');control=box(False,8);control.pack_start(value,False,False,0)
                    limit=Gtk.SpinButton.new_with_range(0,1440,5);limit.set_value(data['limits'].get(app,0));limit.set_tooltip_text('Daily reminder in minutes; 0 disables it.');limit.get_accessible().set_name(app+' daily reminder in minutes')
                    def changed(widget,app=app):
                        minutes=widget.get_value_as_int();self.work(lambda:S.set_limit(app,minutes))
                    limit.connect('value-changed',changed)
                    control.pack_start(limit,False,False,0)
                    row=self.row(app_group,app,'Daily reminder (minutes, 0 = off)',control);app_rows[app]=(row,value)
                app_rows[app][1].set_text(S.duration(seconds))
            self.show();app_empty.set_visible(not data['apps'])
        def refresh():
            if not self.alive or generation!=self.generation:return False
            if not busy[0]:busy[0]=True;self.work(read,render)
            return True
        refresh();self.usage_timer=GLib.timeout_add_seconds(5,refresh)

