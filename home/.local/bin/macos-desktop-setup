#!/usr/bin/env python3
"""Seed desktop shortcuts once, preserving existing desktop contents."""
from pathlib import Path
import shutil
home=Path.home()
marker=home/'.local/state/macos-desktop/icons-seeded'
if not marker.exists():
 desktop=home/'Desktop';desktop.mkdir(exist_ok=True)
 for name in ['Documents','Downloads','Projects']:
  target=home/name;target.mkdir(exist_ok=True)
  link=desktop/name
  if not link.exists() and not link.is_symlink():link.symlink_to(target,target_is_directory=True)
 for name,command,image in [('Finder','dolphin','system-file-manager'),('Browser','brave','brave-browser'),('Terminal','kitty','utilities-terminal'),('Code','code','visual-studio-code')]:
  executable=shutil.which(command)
  if not executable:continue
  file=desktop/(name+'.desktop')
  if file.exists():continue
  file.write_text('[Desktop Entry]\nType=Application\nName='+name+'\nExec="'+executable.replace('\\','\\\\').replace('"','\\"')+'"\nIcon='+image+'\nTerminal=false\n')
  file.chmod(0o755)
 marker.parent.mkdir(parents=True,exist_ok=True);marker.touch()
