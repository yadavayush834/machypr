#!/usr/bin/python
"""HiDPI Tahoe dock with restrained magnification and auto-hide."""
import gi
import json
import math
import os
from pathlib import Path
import signal
import socket
import runpy
import subprocess
import time
import cairo

gi.require_version('Gtk','3.0')
gi.require_version('GtkLayerShell','0.1')
gi.require_version('PangoCairo','1.0')
from gi.repository import Gtk,Gdk,Gio,GLib,GtkLayerShell,Pango,PangoCairo

HOME=Path.home()
APPEARANCE=runpy.run_path(str(HOME/".local/bin/macos-appearance"))
DARK=APPEARANCE["current"]()=="dark"
GLASS=runpy.run_path(str(HOME/".local/bin/macos-glass"))
GLASS_MODE=GLASS['enabled']()
MODEL=runpy.run_path(str(HOME/'.local/bin/macos-dock-model'))
KNOWN={'org.kde.dolphin':('Finder','system-file-manager'),
       'brave-browser':('Brave','brave-browser'),'kitty':('Terminal','utilities-terminal'),
       'code':('Visual Studio Code','visual-studio-code'),
       'org.kde.okular':('Preview','org.kde.okular'),
       'org.pulseaudio.pavucontrol':('Sound','multimedia-volume-control')}
DESKTOP_APPS={}
for app in Gio.AppInfo.get_all():
    keys=[app.get_id(),app.get_executable()]
    startup_class=getattr(app,'get_startup_wm_class',None)
    if startup_class:keys.append(startup_class())
    for key in keys:
        if key:DESKTOP_APPS.setdefault(key.removesuffix('.desktop').rsplit('/',1)[-1].casefold(),app)
LAUNCHPAD=('Launchpad','','view-app-grid',[str(HOME/'.local/bin/macos-launchpad')])
DASHBOARD=('Dashboard','','x-office-calendar',[str(HOME/'.local/bin/macos-dashboard')])
TRASH=('Trash','','user-trash',['dolphin','trash:/'])
# Everyday launchers persist, including apps installed while the dock is running.
def pinned_apps():
 pins=[
  ('Finder','org.kde.dolphin','system-file-manager',['dolphin']),
  ('Visual Studio Code','code','visual-studio-code',[str(HOME/'.local/bin/code'),'--new-window']),
  ('Brave','brave-browser','brave-browser',[str(HOME/'.local/bin/brave'),'--new-window']),
  ('Terminal','kitty','utilities-terminal',['kitty']),
 ]
 for app_id,classname,label,icon in [
  ('com.usebruno.Bruno','bruno','Bruno','bruno'),
  ('io.dbeaver.DBeaverCommunity','DBeaver','DBeaver','dbeaver'),
  ('org.gnome.meld','meld','Meld','meld'),
  ('org.gnome.gitg','gitg','Gitg','gitg'),
 ]:
  exports=[HOME/'.local/share/flatpak/exports/share/applications',Path('/var/lib/flatpak/exports/share/applications')]
  if any((folder/(app_id+'.desktop')).exists() for folder in exports):
   pins.append((label,classname,icon,['flatpak','run',app_id]+(['--ozone-platform=wayland'] if app_id=='com.usebruno.Bruno' else [])))
 return pins
PINNED=pinned_apps()
APPS=[LAUNCHPAD,*PINNED,DASHBOARD,TRASH]
BASE=52
SLOT=60
EDGE=16
DIVIDER=13
WIDTH=EDGE*2+SLOT*len(APPS)+DIVIDER
HEIGHT=112
SESSION=os.environ.get('HYPRLAND_INSTANCE_SIGNATURE','')
CACHE=HOME/'.cache/macos-desktop/dock-workspaces.json'
try:
    saved=json.loads(CACHE.read_text())
    origins=saved['origins'] if saved.get('session')==SESSION else {}
except (OSError,ValueError,KeyError,TypeError):origins={}
if not isinstance(origins,dict):origins={}

def spawn(args):
    subprocess.Popen(args,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)

def query(command):
    # Talk to the compositor directly, without starting hyprctl for every query.
    try:
        path=Path(os.environ['XDG_RUNTIME_DIR'])/'hypr'/SESSION/'.socket.sock'
        with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as connection:
            connection.settimeout(.25)
            connection.connect(str(path))
            connection.sendall(('j/'+command).encode())
            chunks=[]
            while True:
                data=connection.recv(65536)
                if not data:break
                chunks.append(data)
        return json.loads(b''.join(chunks))
    except (OSError,ValueError,KeyError):return None

def clients():return query('clients') or []

def activate(index):
    if not 0<=index<len(APPS):return
    _,classname,_,cmd=APPS[index]
    if not classname:spawn(cmd);return
    workspace=query('activeworkspace')
    if not workspace or 'name' not in workspace:return
    # Re-query at click time: never follow a stale icon to another workspace.
    groups=MODEL['workspace_apps'](clients(),workspace.get('id',workspace['name']),origins)
    active=(query('activewindow') or {}) if MODEL['matching_windows'](groups,classname) else {}
    window=MODEL['activation_target'](MODEL['matching_windows'](groups,classname),active.get('address'))
    if window:
        target=json.dumps('address:'+window['address'])
        if window['workspace']['name']=='special:minimized':
            subprocess.run(['hyprctl','dispatch','hl.dsp.window.move({workspace='+json.dumps(workspace['name'])+',window='+target+',follow=false})'],stdout=subprocess.DEVNULL)
        subprocess.run(['hyprctl','dispatch','hl.dsp.focus({window='+target+'})'],stdout=subprocess.DEVNULL)
        subprocess.run(['hyprctl','dispatch','hl.dsp.window.bring_to_top()'],stdout=subprocess.DEVNULL)
    elif cmd:
        spawn(cmd)
    GLib.idle_add(refresh_event)

def rounded(cr,x,y,w,h,r):
    cr.new_sub_path()
    for cx,cy,start in [(x+w-r,y+r,-90),(x+w-r,y+h-r,0),(x+r,y+h-r,90),(x+r,y+r,180)]:
        cr.arc(cx,cy,r,math.radians(start),math.radians(start+90))
    cr.close_path()

theme=Gtk.IconTheme.new();theme.set_custom_theme('MacTahoe')
icon_cache={}
def load_icon(icon):
    key=icon.to_string() if isinstance(icon,Gio.Icon) else icon
    if key not in icon_cache:
        try:
            flags=Gtk.IconLookupFlags.FORCE_SVG|Gtk.IconLookupFlags.FORCE_SIZE
            info=theme.lookup_by_gicon(icon,256,flags) if isinstance(icon,Gio.Icon) else theme.lookup_icon(icon,256,flags)
            if not info:info=theme.lookup_icon('application-x-executable',256,flags)
            icon_cache[key]=info.load_icon() if info else None
        except GLib.Error:icon_cache[key]=None
    return icon_cache[key]
icons=[load_icon(app[2]) for app in APPS]

window=Gtk.Window();window.set_name('macos-dock');window.set_decorated(False);window.set_resizable(False)
window.set_app_paintable(True)
visual=window.get_screen().get_rgba_visual()
if visual:window.set_visual(visual)
GtkLayerShell.init_for_window(window);GtkLayerShell.set_namespace(window,'macos-dock');GtkLayerShell.set_layer(window,GtkLayerShell.Layer.TOP)
GtkLayerShell.set_anchor(window,GtkLayerShell.Edge.BOTTOM,True);GtkLayerShell.set_margin(window,GtkLayerShell.Edge.BOTTOM,4);GtkLayerShell.set_exclusive_zone(window,0)
canvas=Gtk.DrawingArea();canvas.set_size_request(WIDTH,HEIGHT);canvas.set_can_focus(True);canvas.set_has_tooltip(False);canvas.get_accessible().set_name('Application Dock')
canvas.add_events(Gdk.EventMask.POINTER_MOTION_MASK|Gdk.EventMask.LEAVE_NOTIFY_MASK|Gdk.EventMask.ENTER_NOTIFY_MASK|Gdk.EventMask.BUTTON_PRESS_MASK|Gdk.EventMask.KEY_PRESS_MASK)
window.add(canvas)
state={'pointer':None,'hover':None,'amount':0.,'last':time.monotonic(),'timer':None,'running':set(),'focus':0,'tick':None,'reveal':0.,'visible_target':0.,'smooth_pointer':None}

def center(index):return EDGE+SLOT*(index+.5)+(DIVIDER if index==len(APPS)-1 else 0)
def hit(x,y):
    if y<20:return None
    return next((i for i in range(len(APPS)) if abs(x-center(i))<SLOT/2),None)

def draw(widget,cr):
    cr.translate(0,(1-state['reveal'])*HEIGHT)
    # Only the shelf is frosted; the icon artwork remains completely opaque.
    y=HEIGHT-79
    for spread in range(8,0,-1):
        cr.set_source_rgba(0,0,0,.006*(9-spread));rounded(cr,8-spread/2,y+3-spread/2,WIDTH-16+spread,72+spread,20+spread/2);cr.fill()
    glass=GLASS_MODE
    rounded(cr,8,y,WIDTH-16,73,22);cr.set_source_rgba(*((.13,.17,.23,.74 if glass else .94) if DARK else (.94,.97,1,.72 if glass else .90)));cr.fill_preserve();cr.set_source_rgba(1,1,1,.32 if DARK else .82);cr.set_line_width(1);cr.stroke()
    if glass:
        # Static rim lighting with pointer-responsive glare; no idle animation.
        cr.save();rounded(cr,9,y+1,WIDTH-18,71,19);cr.clip()
        shine=cairo.LinearGradient(0,y,0,y+73)
        shine.add_color_stop_rgba(0,1,1,1,.40);shine.add_color_stop_rgba(.08,1,1,1,.08);shine.add_color_stop_rgba(.65,1,1,1,0);shine.add_color_stop_rgba(1,1,1,1,.18)
        cr.set_source(shine);cr.paint()
        if state['smooth_pointer'] is not None:
            glow=cairo.RadialGradient(state['smooth_pointer'],y,0,state['smooth_pointer'],y,105)
            glow.add_color_stop_rgba(0,1,1,1,.25);glow.add_color_stop_rgba(1,1,1,1,0)
            cr.set_source(glow);cr.paint()
        cr.restore()
    cr.set_source_rgba(*((.80,.80,.85,.25) if DARK else (.25,.25,.29,.22)));x=EDGE+(len(APPS)-1)*SLOT+DIVIDER/2;cr.move_to(x,y+13);cr.line_to(x,y+59);cr.set_line_width(.75);cr.stroke()
    for i,(_,classname,_,_) in enumerate(APPS):
        distance=abs(center(i)-(state['smooth_pointer'] if state['smooth_pointer'] is not None else -1000))
        influence=max(0,1-distance/105)
        size=BASE+min(13,BASE*.25)*state['amount']*(.5-.5*math.cos(math.pi*influence))
        left=center(i)-size/2;top=HEIGHT-19-size
        image=icons[i]
        if image:
            cr.save();cr.translate(left,top);cr.scale(size/image.get_width(),size/image.get_height());Gdk.cairo_set_source_pixbuf(cr,image,0,0);cr.paint();cr.restore()
        if classname and classname in state['running']:
            cr.set_source_rgba(*((.91,.91,.95,.90) if DARK else (.16,.16,.19,.85)));cr.arc(center(i),HEIGHT-12,1.7,0,math.tau);cr.fill()
        if canvas.has_focus() and state['focus']==i:
            cr.set_source_rgba(.10,.45,.95,.85);rounded(cr,center(i)-29,HEIGHT-78,58,67,10);cr.set_line_width(1.5);cr.stroke()
    if state['hover'] is not None:
        label=APPS[state['hover']][0];layout=widget.create_pango_layout(label);layout.set_font_description(Pango.FontDescription('Inter 11'))
        tw,th=layout.get_pixel_size();left=max(3,min(WIDTH-tw-23,center(state['hover'])-tw/2-10))
        rounded(cr,left,0,tw+20,th+10,5);cr.set_source_rgba(*((.20,.20,.23,.98) if DARK else (.96,.96,.98,.98)));cr.fill_preserve();cr.set_source_rgba(.2,.2,.25,.20);cr.set_line_width(.7);cr.stroke()
        cr.set_source_rgb(*((.96,.96,.98) if DARK else (.12,.12,.14)));cr.move_to(left+10,5);PangoCairo.show_layout(cr,layout)
    return False
canvas.connect('draw',draw)

def cancel_hide():
    if state['timer'] is not None:GLib.source_remove(state['timer']);state['timer']=None

def hide():
    state['timer']=None;state['visible_target']=0.;state['pointer']=None;state['hover']=None;animate();return False

def schedule(*_):
    cancel_hide();state['pointer']=None;state['hover']=None;animate();state['timer']=GLib.timeout_add(650,hide);return False

def reveal(widget=None,event=None):
    cancel_hide();refresh();window.show_all();state['visible_target']=1.;animate()
    if widget is canvas and event is not None:
        state['pointer']=event.x;state['hover']=hit(event.x,event.y);canvas.queue_draw()
    return False

def motion(widget,event):
    cancel_hide();state['pointer']=event.x;state['hover']=hit(event.x,event.y);animate();widget.queue_draw();return False
canvas.connect('motion-notify-event',motion)
canvas.connect('enter-notify-event',reveal);canvas.connect('leave-notify-event',schedule)

def tooltip(widget,x,y,keyboard,tip):
    index=state['focus'] if keyboard else hit(x,y)
    if index is None:return False
    tip.set_text(APPS[index][0]);return True
canvas.connect('query-tooltip',tooltip)

def click(widget,event):
    index=hit(event.x,event.y)
    if index is not None and event.button==1:activate(index)
    return True
canvas.connect('button-press-event',click)

def key(widget,event):
    if event.keyval in (Gdk.KEY_Left,Gdk.KEY_Right):state['focus']=(state['focus']+(1 if event.keyval==Gdk.KEY_Right else -1))%len(APPS);canvas.queue_draw();return True
    if event.keyval in (Gdk.KEY_Return,Gdk.KEY_space):activate(state['focus']);return True
    if event.keyval==Gdk.KEY_Escape:hide();return True
    return False
canvas.connect('key-press-event',key)

def animate():
    if state['tick'] is None:
        state['last']=time.monotonic()
        state['tick']=canvas.add_tick_callback(frame)

def frame(widget,clock):
    now=time.monotonic();dt=min(.1,now-state['last']);state['last']=now
    factor=1-math.exp(-22*dt) if Gtk.Settings.get_default().get_property('gtk-enable-animations') else 1
    target=1. if state['pointer'] is not None else 0.
    state['amount']+=(target-state['amount'])*factor
    state['reveal']+=(state['visible_target']-state['reveal'])*factor
    pointer=state['pointer']
    if pointer is not None:
        if state['smooth_pointer'] is None:state['smooth_pointer']=pointer
        state['smooth_pointer']+=(pointer-state['smooth_pointer'])*factor
    settled=abs(target-state['amount'])<.002 and abs(state['visible_target']-state['reveal'])<.002
    if pointer is not None:settled=settled and abs(pointer-state['smooth_pointer'])<.1
    if settled:
        state['amount']=target;state['reveal']=state['visible_target'];state['tick']=None
        if not state['reveal']:window.hide()
    canvas.queue_draw()
    return not settled

def refresh():
    global DARK,APPS,icons,WIDTH,SLOT,BASE,GLASS_MODE,PINNED
    DARK=APPEARANCE['current']()=='dark'
    GLASS_MODE=GLASS['enabled']()
    workspace=query('activeworkspace')
    windows=query('clients')
    if not workspace or 'name' not in workspace or not isinstance(windows,list):return True
    previous=dict(origins)
    groups=MODEL['workspace_apps'](windows,workspace.get('id',workspace['name']),origins)
    if origins!=previous:
        try:
            CACHE.parent.mkdir(parents=True,exist_ok=True)
            temporary=CACHE.with_suffix('.tmp')
            temporary.write_text(json.dumps({'session':SESSION,'origins':origins}))
            temporary.replace(CACHE)
        except OSError:pass
    PINNED=pinned_apps()
    apps=[LAUNCHPAD,*PINNED,DASHBOARD]
    pinned_classes=MODEL['pinned_class_names'](PINNED)
    for classname in groups:
        if classname.casefold() in pinned_classes:continue
        desktop=DESKTOP_APPS.get(classname.casefold())
        if classname in KNOWN:label,icon=KNOWN[classname]
        elif desktop:label,icon=desktop.get_display_name(),desktop.get_icon() or 'application-x-executable'
        else:label,icon=classname.rsplit('.',1)[-1],classname
        apps.append((label,classname,icon,[]))
    apps.append(TRASH)
    if [(a[0],a[1]) for a in apps]!=[(a[0],a[1]) for a in APPS]:
        APPS=apps;icons=[load_icon(a[2]) for a in APPS]
        monitor=Gdk.Display.get_default().get_monitor(0)
        maximum=monitor.get_geometry().width-40 if monitor else 1200
        SLOT=min(60,max(20,(maximum-EDGE*2-DIVIDER)/len(APPS)))
        BASE=min(52,SLOT-8)
        WIDTH=int(EDGE*2+SLOT*len(APPS)+DIVIDER)
        canvas.set_size_request(WIDTH,HEIGHT);window.resize(WIDTH,HEIGHT)
        state['hover']=None;state['pointer']=None;state['focus']=min(state['focus'],len(APPS)-1)
    state['running']={a[1] for a in APPS if a[1] and MODEL['matching_windows'](groups,a[1])}
    canvas.queue_draw();return True

# Workspace/open/close/move events update the shelf without waiting for polling.
event_socket=None
event_buffer=b''
pending_refresh=None
def refresh_event():
    global pending_refresh
    pending_refresh=None;refresh();return False

def on_event(channel,condition):
    global event_socket,event_buffer,pending_refresh
    if condition & (GLib.IO_HUP|GLib.IO_ERR):
        event_socket.close();event_socket=None;return False
    try:
        data=event_socket.recv(65536)
        if not data:
            event_socket.close();event_socket=None;return False
    except BlockingIOError:return True
    except OSError:
        event_socket.close();event_socket=None;return False
    event_buffer+=data
    lines=event_buffer.split(b'\n');event_buffer=lines.pop()
    relevant={b'workspace',b'workspacev2',b'focusedmon',b'openwindow',b'closewindow',
              b'movewindow',b'movewindowv2',b'monitoradded',b'monitorremoved',b'configreloaded'}
    if not any(line.partition(b'>>')[0] in relevant for line in lines):return True
    if pending_refresh is None:pending_refresh=GLib.timeout_add(70,refresh_event)
    return True

def connect_events():
    global event_socket,event_buffer
    if event_socket is None and SESSION:
        candidate=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
        try:
            candidate.connect(str(Path(os.environ.get('XDG_RUNTIME_DIR','/tmp'))/'hypr'/SESSION/'.socket2.sock'))
            candidate.setblocking(False);event_socket=candidate;event_buffer=b''
            GLib.io_add_watch(event_socket,GLib.IO_IN|GLib.IO_HUP|GLib.IO_ERR,on_event)
        except OSError:candidate.close()
    return True

GLib.timeout_add_seconds(2,refresh);refresh()
GLib.timeout_add_seconds(5,connect_events);connect_events()

sensor=Gtk.Window();sensor.set_name('dock-sensor');sensor.set_decorated(False)
GtkLayerShell.init_for_window(sensor);GtkLayerShell.set_namespace(sensor,'macos-dock-sensor');GtkLayerShell.set_layer(sensor,GtkLayerShell.Layer.TOP)
for edge in (GtkLayerShell.Edge.BOTTOM,GtkLayerShell.Edge.LEFT,GtkLayerShell.Edge.RIGHT):GtkLayerShell.set_anchor(sensor,edge,True)
GtkLayerShell.set_exclusive_zone(sensor,0);sensor.set_size_request(-1,2);sensor.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK)
sensor.connect('enter-notify-event',reveal);sensor.connect('leave-notify-event',schedule)
def toggle(*_):
    if window.get_visible():hide()
    else:reveal();state['timer']=GLib.timeout_add(5000,hide)
    return False
signal.signal(signal.SIGUSR1,lambda *_:GLib.idle_add(toggle))
css=Gtk.CssProvider();css.load_from_data(b'window#macos-dock,window#dock-sensor {background:transparent;border:none;box-shadow:none;} tooltip {background:rgba(245,245,248,.97);color:#202024;border:1px solid rgba(60,60,65,.25);border-radius:6px;font-family:Inter;font-size:12px;box-shadow:0 2px 6px rgba(0,0,0,.16);}')
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(),css,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
window.show_all();window.hide();sensor.show_all();window.connect('destroy',Gtk.main_quit);Gtk.main()
