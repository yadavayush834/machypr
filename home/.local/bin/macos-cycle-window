#!/usr/bin/env python3
"""Alt+Tab: cycle this workspace's windows and raise the selected window."""
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import time


def query(name):
    return json.loads(subprocess.check_output(['hyprctl', name, '-j'], timeout=2))


def choose_target(windows, workspace, active, backwards=False, state=None):
    # Windows covered by a maximized client can report acceptsInput=false;
    # keep them eligible so Alt+Tab can reveal them.
    eligible = [w for w in windows if w.get('mapped', True) and not w.get('hidden', False)
                and (w.get('workspace', {}).get('id') == workspace or w.get('pinned', False))
                and not w.get('workspace', {}).get('name', '').startswith('special:')]
    if not eligible:
        return None, {}
    addresses = {w['address'] for w in eligible}
    state = state or {}
    continuing = (state.get('workspace') == workspace and state.get('last') == active
                  and set(state.get('order', [])) == addresses)
    if continuing:
        order = state['order']
    else:
        eligible.sort(key=lambda w: (0 if w['address'] == active else 1,
                                   w.get('focusHistoryID', 999) if w.get('focusHistoryID', -1) >= 0 else 999,
                                   w['address']))
        order = [w['address'] for w in eligible]
    if active in order:
        target = order[(order.index(active) + (-1 if backwards else 1)) % len(order)]
    else:
        target = order[-1 if backwards else 0]
    return target, {'workspace': workspace, 'order': order, 'last': target}


def target_window(windows, workspace, active, backwards=False):
    return choose_target(windows, workspace, active, backwards)[0]


def main():
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    state_path = runtime / 'macos-alt-tab.json'
    with (runtime / 'macos-alt-tab.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if '--end' in sys.argv:
            state_path.unlink(missing_ok=True)
            return
        try:
            state = json.loads(state_path.read_text())
            if state.get('session') != os.environ.get('HYPRLAND_INSTANCE_SIGNATURE') or time.time() - state.get('updated', 0) > 15:
                state = {}
        except (OSError, ValueError):
            state = {}
        workspace = query('activeworkspace')['id']
        active = query('activewindow').get('address')
        target, state = choose_target(query('clients'), workspace, active, '--previous' in sys.argv, state)
        if target is None or target == active:
            return
        # Floating windows need an explicit raise in addition to keyboard focus.
        command = ('dispatch hl.dsp.focus({window=' + json.dumps('address:' + target) + '}); '
                   'dispatch hl.dsp.window.bring_to_top()')
        subprocess.run(['hyprctl', '--batch', command], capture_output=True, text=True, timeout=2, check=True)
        if query('activewindow').get('address') == target:
            state.update(session=os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'), updated=time.time())
            state_path.write_text(json.dumps(state))


if __name__ == '__main__':
    try:
        main()
    except (OSError, subprocess.SubprocessError, ValueError, KeyError):
        pass
