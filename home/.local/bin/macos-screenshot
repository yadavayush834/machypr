#!/usr/bin/env python3
"""Mac-style screenshot shortcuts for Hyprland, grim and wl-clipboard."""
import argparse
import datetime
import json
from pathlib import Path
import shutil
import subprocess
import tempfile
import time


def capture(mode, clipboard_only=False, delay=0, directory=None, cursor=False):
    if delay:time.sleep(delay)
    command=['grim']
    if cursor:command.append('-c')
    if mode=='region':
        region=subprocess.run(['slurp'],capture_output=True,text=True)
        if region.returncode or not region.stdout.strip():return None
        command+=['-g',region.stdout.strip()]
    elif mode=='window':
        window=json.loads(subprocess.check_output(['hyprctl','activewindow','-j'],text=True))
        if not window or not window.get('mapped',True):raise RuntimeError('No active window to capture')
        x,y=window['at'];width,height=window['size']
        command+=['-g',f'{int(x)},{int(y)} {int(width)}x{int(height)}']
    elif mode!='screen':raise ValueError('Unsupported screenshot mode')
    directory=Path(directory) if directory else Path.home()/'Pictures/Screenshots'
    if clipboard_only:
        image=subprocess.check_output(command+['-'])
        subprocess.run(['wl-copy','--type','image/png'],input=image,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=True)
        result='Copied to clipboard'
    else:
        directory.mkdir(parents=True,exist_ok=True)
        target=directory/('Screenshot '+datetime.datetime.now().strftime('%Y-%m-%d at %H.%M.%S.%f')+'.png')
        fd,temporary=tempfile.mkstemp(prefix='.capture-',suffix='.png',dir=directory)
        __import__('os').close(fd)
        try:
            subprocess.run(command+[temporary],check=True)
            Path(temporary).replace(target)
        finally:Path(temporary).unlink(missing_ok=True)
        if shutil.which('wl-copy'):
            subprocess.run(['wl-copy','--type','image/png'],input=target.read_bytes(),stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,check=False)
        result=str(target)
    sound=Path.home()/'.local/bin/macos-sound'
    if sound.exists():subprocess.run([str(sound),'screenshot'],check=False)
    if shutil.which('notify-send'):subprocess.run(['notify-send','Screenshot saved',result],check=False)
    return result


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode',choices=['screen','region','window','menu'],nargs='?',default='menu')
    parser.add_argument('--clipboard',action='store_true',help='Copy only; do not save a file')
    parser.add_argument('--delay',type=float,default=0)
    parser.add_argument('--cursor',action='store_true')
    parser.add_argument('--directory',type=Path)
    args=parser.parse_args()
    if not 0<=args.delay<=60:parser.error('Delay must be between 0 and 60 seconds')
    try:
        if args.mode=='menu':
            subprocess.run([str(Path.home()/'.local/bin/macos-menu'),'screenshot'],check=True)
        else:
            result=capture(args.mode,args.clipboard,args.delay,args.directory,args.cursor)
            if result:print(result)
    except (OSError,ValueError,RuntimeError,subprocess.SubprocessError) as error:
        if shutil.which('notify-send'):subprocess.run(['notify-send','Screenshot failed',str(error)],check=False)
        raise SystemExit(1)


if __name__=='__main__':main()
