#!/usr/bin/python
import json,subprocess
try:
 w=json.loads(subprocess.check_output(['hyprctl','activewindow','-j'],stderr=subprocess.DEVNULL))
 names={'kitty':'Terminal','brave-browser':'Brave','code':'Visual Studio Code','org.kde.dolphin':'Finder','org.kde.okular':'Preview','org.pulseaudio.pavucontrol':'Sound','firefox':'Firefox'}
 print(json.dumps({'text':names.get(w.get('class'),w.get('class','Finder').split('.')[-1].title()) or 'Finder'}))
except Exception: print('{"text":"Finder"}')
