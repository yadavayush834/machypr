#!/usr/bin/env python3
"""Read-only system responsiveness report; stores no window titles or browsing data."""
import argparse
import json
from pathlib import Path
import subprocess
import time


def command(*args):
    try:return subprocess.run(args,capture_output=True,text=True,timeout=6).stdout.strip()
    except (OSError,subprocess.TimeoutExpired):return 'unavailable'


def report():
    disks={}
    for disk in Path('/sys/block').iterdir():
        try:
            if (disk/'queue/rotational').read_text().strip()!='1':continue
            disks[disk.name]={'scheduler':(disk/'queue/scheduler').read_text().strip(),'read_ahead_kib':int((disk/'queue/read_ahead_kb').read_text())}
        except OSError:pass
    temperatures={}
    for zone in Path('/sys/class/thermal').glob('thermal_zone*'):
        try:
            name=(zone/'type').read_text().strip()
            if 'pkg_temp' in name:temperatures[name]=int((zone/'temp').read_text())/1000
        except (OSError,ValueError):pass
    throttle=Path('/sys/devices/system/cpu/cpu0/thermal_throttle/package_throttle_count')
    return {'recorded_at':time.time(),'boot_id':Path('/proc/sys/kernel/random/boot_id').read_text().strip(),
        'boot':command('systemd-analyze'),'disk':disks,'memory':command('free','-b'),'swap':command('swapon','--show'),
        'pressure':{name:Path('/proc/pressure'/Path(name)).read_text().strip() for name in ('cpu','memory','io')},
        'cpu_package_celsius':temperatures,'package_throttle_count':int(throttle.read_text()) if throttle.exists() else None,
        'writeback':command('sysctl','vm.dirty_background_bytes','vm.dirty_bytes'),
        'priority_service':command('systemctl','--user','show','macos-responsiveness.service','-p','ActiveState','-p','CPUUsageNSec','-p','MemoryCurrent','-p','NRestarts')}


def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--save',action='store_true');args=parser.parse_args();data=report()
    state=Path.home()/'.local/state/macos-performance'
    if args.save:
        state.mkdir(parents=True,exist_ok=True);state.chmod(0o700)
        path=state/'latest.json';temp=path.with_suffix('.tmp');temp.write_text(json.dumps(data,indent=2)+'\n');temp.chmod(0o600);temp.replace(path)
        # Keep one report per boot; this lets the next reboot be compared honestly.
        path=state/('boot-'+data['boot_id']+'.json')
        if not path.exists():path.write_text(json.dumps(data,indent=2)+'\n');path.chmod(0o600)
    print(json.dumps(data,indent=2))


if __name__=='__main__':main()
