#!/usr/bin/env python3
"""Non-focus-stealing volume/brightness HUD; repeated keys update one surface."""
import fcntl
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import time

kind=sys.argv[1] if len(sys.argv)>1 else 'volume'
if kind not in ('volume','brightness'):raise SystemExit(2)
try:
 if kind=='volume':
  raw=subprocess.check_output(['wpctl','get-volume','@DEFAULT_AUDIO_SINK@'],text=True,timeout=1)
  value=max(0,min(1,float(raw.split()[1])));muted='MUTED' in raw
 else:
  value=float(subprocess.check_output(['brightnessctl','get'],timeout=1))/float(subprocess.check_output(['brightnessctl','max'],timeout=1));muted=False
except (OSError,subprocess.SubprocessError,ValueError,IndexError,ZeroDivisionError):raise SystemExit(0)
runtime=Path(os.environ.get('XDG_RUNTIME_DIR','/tmp'))
statefile=runtime/'macos-osd.json'
temporary=runtime/f'macos-osd-{os.getpid()}.tmp'
temporary.write_text(json.dumps({'kind':kind,'value':value,'muted':muted,'time':time.monotonic()}));temporary.replace(statefile)
lock=(runtime/'macos-osd.lock').open('w')
try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
except BlockingIOError:raise SystemExit(0)
import gi
gi.require_version('Gtk','3.0');gi.require_version('GtkLayerShell','0.1')
from gi.repository import Gtk,Gdk,GLib,GtkLayerShell as Layer
win=Gtk.Window(name='macos-osd');win.set_decorated(False);win.set_resizable(False)
Layer.init_for_window(win);Layer.set_namespace(win,'macos-osd');Layer.set_layer(win,Layer.Layer.OVERLAY)
Layer.set_keyboard_mode(win,Layer.KeyboardMode.NONE);Layer.set_exclusive_zone(win,-1)
Layer.set_anchor(win,Layer.Edge.BOTTOM,True);Layer.set_margin(win,Layer.Edge.BOTTOM,120)
canvas=Gtk.DrawingArea();canvas.set_size_request(160,160);win.add(canvas)
state={}
def draw(_,cr):
 cr.set_source_rgba(1,1,1,.92);cr.set_line_width(4);cr.set_line_cap(1);cr.set_line_join(1)
 if state.get('kind')=='brightness':
  cr.arc(80,67,17,0,math.tau);cr.stroke()
  for i in range(8):
   angle=i*math.pi/4;cr.move_to(80+25*math.cos(angle),67+25*math.sin(angle));cr.line_to(80+32*math.cos(angle),67+32*math.sin(angle));cr.stroke()
 else:
  cr.move_to(49,57);cr.line_to(62,57);cr.line_to(79,42);cr.line_to(79,92);cr.line_to(62,77);cr.line_to(49,77);cr.close_path();cr.fill()
  if state.get('muted'):
   cr.move_to(94,57);cr.line_to(112,77);cr.move_to(112,57);cr.line_to(94,77);cr.stroke()
  else:
   for radius in (17,28,39):
    cr.arc(80,67,radius,-.65,.65);cr.stroke()
 level=0 if state.get('muted') else round(state.get('value',0)*16)
 for i in range(16):
  cr.set_source_rgba(1,1,1,.95 if i<level else .18);cr.rectangle(16+i*8,127,6,7);cr.fill()
 return False
canvas.connect('draw',draw)
def refresh():
 global state
 try:current=json.loads(statefile.read_text())
 except (OSError,ValueError):return True
 age=time.monotonic()-current['time']
 if age>1.35:Gtk.main_quit();return False
 Gtk.Widget.set_opacity(win,max(0,min(1,(1.35-age)/.2)))
 if current!=state:state=current;canvas.queue_draw()
 return True
css=Gtk.CssProvider();css.load_from_data(b'window#macos-osd {background:rgba(38,38,42,.80);border-radius:18px;border:1px solid rgba(255,255,255,.12);}')
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(),css,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION+10)
win.show_all();refresh();GLib.timeout_add(40,refresh);Gtk.main()
