#!/usr/bin/env python3
"""Read applied hardware state or request an authenticated power-profile change."""
import argparse
import json
from pathlib import Path
import subprocess
import sys

SOURCE=Path.home()/'.local/share/macos-desktop/power-profiles.py'
INSTALLED=Path('/usr/local/libexec/macos-power-profile')


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    group=parser.add_mutually_exclusive_group();group.add_argument('--set',choices=('battery-saver','standard','performance'));group.add_argument('--install',action='store_true');group.add_argument('--restore',action='store_true');group.add_argument('--status',action='store_true');args=parser.parse_args()
    if args.install:command=['pkexec','/usr/bin/python','-I',str(SOURCE),'--install']
    elif args.set or args.restore:
        if not INSTALLED.exists():raise SystemExit('Install hardware profiles in System Settings → Performance first.')
        command=['pkexec','/usr/bin/python','-I',str(INSTALLED),*(['--set',args.set] if args.set else ['--restore'])]
    else:command=['/usr/bin/python','-I',str(INSTALLED if INSTALLED.exists() else SOURCE),'--status']
    result=subprocess.run(command)
    if result.returncode:raise SystemExit(result.returncode)
    if args.install or args.set or args.restore:
        subprocess.run(['systemctl','--user','try-restart','macos-responsiveness.service'],check=False)


if __name__=='__main__':main()
