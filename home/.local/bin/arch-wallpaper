#!/usr/bin/env bash
set -euo pipefail
dir="$HOME/.local/share/wallpapers"
mkdir -p "$dir" "$HOME/.config/hypr"
mapfile -d '' files < <(find "$dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) -print0 | sort -z)
((${#files[@]})) || { notify-send 'No wallpapers found' "Add images to $dir"; exit 1; }
choice=$(printf '%s\n' "${files[@]##*/}" | wofi --dmenu --prompt 'Choose wallpaper') || exit 0
[[ -n "$choice" && "$choice" != */* && -f "$dir/$choice" ]] || exit 0
path="$dir/$choice"
# Hyprpaper 0.8 accepts monitor,path,fit_mode over IPC.
hyprctl hyprpaper wallpaper ",$path,cover" >/dev/null
printf 'splash = false\nwallpaper {\n monitor =\n path = %s\n fit_mode = cover\n}\n' "$path" > "$HOME/.config/hypr/hyprpaper.conf"
notify-send 'Wallpaper changed' "$choice"
