#!/usr/bin/env python3
"""Select dock windows from one workspace, preserving minimized-window ownership."""


def workspace_apps(windows, workspace_id, origins):
    live={window['address'] for window in windows}
    for address in list(origins):
        if address not in live:del origins[address]
    for window in windows:
        workspace=window.get('workspace',{})
        if not workspace.get('name','').startswith('special:'):
            origins[window['address']]=workspace.get('id',workspace.get('name'))
    groups={}
    for window in windows:
        workspace=window.get('workspace',{})
        visible=workspace.get('id',workspace.get('name'))==workspace_id
        minimized=workspace.get('name')=='special:minimized' and origins.get(window['address'])==workspace_id
        classname=window.get('class') or window.get('initialClass')
        if classname and window.get('mapped',True) and (visible or minimized):
            groups.setdefault(classname,[]).append(window)
    return groups


def activation_target(windows, active_address=None):
    """Prefer a visible, recently focused window; repeated clicks cycle local windows."""
    ordered=sorted(windows,key=lambda w:(w.get('workspace',{}).get('name')=='special:minimized',
                                          w.get('focusHistoryID',9999)))
    if not ordered:return None
    if len(ordered)>1 and ordered[0]['address']==active_address:return ordered[1]
    return ordered[0]


APP_ALIASES={
 'org.kde.dolphin':{'org.kde.dolphin','dolphin'},
 'brave-browser':{'brave-browser','com.brave.browser','brave'},
 'code':{'code','code-oss','visual-studio-code'},
 'bruno':{'bruno','com.usebruno.bruno'},
 'DBeaver':{'dbeaver','io.dbeaver.dbeavercommunity'},
 'meld':{'meld','org.gnome.meld'},
 'gitg':{'gitg','org.gnome.gitg'},
}

def aliases_for(classname):
 return {x.casefold() for x in APP_ALIASES.get(classname,{classname})}

def matching_windows(groups,classname):
 names=aliases_for(classname)
 return [window for name,windows in groups.items() if name.casefold() in names for window in windows]

def pinned_class_names(pins):
 return {name for pin in pins for name in aliases_for(pin[1])}
