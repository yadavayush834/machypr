#!/usr/bin/env python3
"""Persistent Light/Dark/Auto appearance shared by desktop surfaces."""
import argparse
import configparser
import datetime
import io
import json
from pathlib import Path
import re
import subprocess


def resolve(mode, hour=None):
    if mode not in ('light','dark','auto'):
        raise ValueError('Appearance must be light, dark or auto')
    if mode == 'auto':
        hour = datetime.datetime.now().hour if hour is None else hour
        return 'light' if 7 <= hour < 19 else 'dark'
    return mode


def preference(home=None):
    home = Path.home() if home is None else home
    try:
        data = json.loads((home/'.config/macos-desktop/appearance.json').read_text())
        resolve(data['mode'])
        return data
    except (OSError, ValueError, KeyError, TypeError):
        return {'mode':'light','applied':None}


def current(home=None):
    return resolve(preference(home)['mode'])


def apply(mode, home=None, session=True):
    home = Path.home() if home is None else home
    effective = resolve(mode)
    dark = effective == 'dark'
    theme = 'MacTahoe-Dark' if dark else 'MacTahoe-Light'
    bg, surface, fg, border = ('#1e1e1e','#303034','#f2f2f7','#636369') if dark else ('#ffffff','#ededf1','#202024','#bdbdc4')
    def write(path, text):
        path.parent.mkdir(parents=True,exist_ok=True)
        temporary=path.with_name('.'+path.name+'.appearance-tmp')
        temporary.write_text(text)
        temporary.replace(path)
    for version in ('3','4'):
        p=home/f'.config/gtk-{version}.0/settings.ini'
        text=p.read_text() if p.exists() else '[Settings]\n'
        for key,value in [('gtk-theme-name',theme),('gtk-icon-theme-name','MacTahoe'),('gtk-application-prefer-dark-theme',str(int(dark)))]:
            if re.search(r'^'+key+'=',text,re.M):text=re.sub(r'^'+key+r'=.*$',key+'='+value,text,flags=re.M)
            else:text+=key+'='+value+'\n'
        write(p,text)
    gtk4=home/'.config/gtk-4.0'
    source=gtk4/('gtk-Dark.css' if dark else 'gtk-Light.css')
    if source.exists():
        p=gtk4/'gtk.css'
        temporary=gtk4/'.gtk.css.appearance-tmp'
        temporary.unlink(missing_ok=True)
        temporary.symlink_to(source.name)
        temporary.replace(p)
    kitty=home/'.config/kitty/wallpaper-colors.conf'
    # Replace the complete ANSI palette: dark pastels disappear on white.
    palette = (
        ['#242428','#ff6961','#6cce75','#ffd36c','#64b5ff','#dca4ef','#6ad5d5','#e5e5e5',
         '#aaaaaf','#ff8a84','#91df98','#ffe094','#98ceff','#e8bff7','#99e7e7','#ffffff'] if dark else
        ['#202024','#a51d2d','#186b32','#805500','#0759ac','#803d99','#08656b','#404046',
         '#5c5c64','#b32030','#196c36','#805000','#085db3','#84429b','#09676e','#202024'])
    write(kitty,f'background {bg}\nforeground {fg}\nselection_background #0969da\nselection_foreground #ffffff\ncursor {fg}\ncursor_text_color {bg}\nbackground_opacity 1\ndim_opacity 1\ntext_fg_override_threshold 4.5 ratio\n' +
          ''.join(f'color{i} {value}\n' for i,value in enumerate(palette)) +
          'url_color '+('#64b5ff' if dark else '#005fbd')+'\n')
    wofi=home/'.config/wofi/style.css'
    if wofi.exists():
        text=wofi.read_text().split('/* appearance override */')[0]
        text+=f'\n/* appearance override */\nwindow {{background:{bg};border-color:{border};}}\n#input {{background:{surface};color:{fg};}}\n#text {{color:{fg};}}\n#entry:selected {{background:#0969da;}}\n#entry:selected #text {{color:#ffffff;}}\n'
        write(wofi,text)
    dunst=home/'.config/dunst/dunstrc'
    if dunst.exists():
        text=dunst.read_text()
        text=re.sub(r'(?m)^background = .*$',f'background = "{bg}"',text)
        text=re.sub(r'(?m)^foreground = .*$',f'foreground = "{fg}"',text)
        write(dunst,text)
    kde=home/'.config/kdeglobals'
    if kde.exists():
        settings=configparser.ConfigParser(interpolation=None,strict=False)
        settings.optionxform=str
        settings.read(kde)
        rgb=lambda value: ','.join(str(int(value[i:i+2],16)) for i in (1,3,5))
        for role in ('Window','View','Button','Tooltip','Selection'):
            section='Colors:'+role
            if not settings.has_section(section):settings.add_section(section)
            selected=role=='Selection'
            background='#0969da' if selected else bg if role=='View' else surface
            foreground='#ffffff' if selected else fg
            values={'BackgroundNormal':background,'BackgroundAlternate':background if selected else surface,
                    'ForegroundNormal':foreground,'ForegroundInactive':foreground if selected else '#aaaab2' if dark else '#5c5c64',
                    'ForegroundActive':foreground,'ForegroundLink':foreground if selected else palette[4],
                    'ForegroundVisited':foreground if selected else palette[5],
                    'ForegroundNegative':foreground if selected else palette[1],
                    'ForegroundNeutral':foreground if selected else palette[3],
                    'ForegroundPositive':foreground if selected else palette[2]}
            for key,value in values.items():settings[section][key]=rgb(value)
        if not settings.has_section('General'):settings.add_section('General')
        if not settings.has_section('Icons'):settings.add_section('Icons')
        settings['Icons']['Theme']='MacTahoe'
        settings['General']['ColorScheme']='WhiteSurDark' if dark else 'WhiteSurLight'
        output=io.StringIO();settings.write(output,space_around_delimiters=False)
        write(kde,output.getvalue())
    code=home/'.config/Code/User/settings.json'
    if code.exists():
        try:
            data=json.loads(code.read_text());data['workbench.colorTheme']='Dark Modern' if dark else 'Light Modern'
            colors=data.setdefault('workbench.colorCustomizations',{})
            colors.update({'titleBar.activeBackground':bg,'titleBar.activeForeground':fg,'statusBar.background':surface,'statusBar.foreground':fg})
            write(code,json.dumps(data,indent=2)+'\n')
        except (ValueError,TypeError):pass
    write(home/'.config/macos-desktop/appearance.json',json.dumps({'mode':mode,'applied':effective},indent=2)+'\n')
    if session:
        def command(*args):
            try:subprocess.run(args,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=4,check=False)
            except (OSError,subprocess.SubprocessError):pass
        command('gsettings','set','org.gnome.desktop.interface','gtk-theme',theme)
        command('gsettings','set','org.gnome.desktop.interface','icon-theme','MacTahoe')
        command('gsettings','set','org.gnome.desktop.interface','color-scheme','prefer-dark' if dark else 'prefer-light')
        command('pkill','-USR1','-u',str(__import__('os').getuid()),'-x','kitty')
        command('dunstctl','reload')
        # hyprbars caches rendered title textures. A config-only reload rebuilds
        # those textures as well as updating the background, without monitor reloads.
        command('hyprctl','reload','config-only')
    return effective


if __name__ == '__main__':
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode',choices=['light','dark','auto','status','sync'])
    args=parser.parse_args()
    if args.mode=='status':print(json.dumps({**preference(),'effective':current()}))
    elif args.mode=='sync':
        selected=preference()
        if selected.get('applied')!=current():apply(selected['mode'])
    else:print(apply(args.mode))
