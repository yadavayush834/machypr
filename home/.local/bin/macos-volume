#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
 up) wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+;;
 down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-;;
 mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle;;
 *) echo 'Usage: macos-volume up|down|mute' >&2; exit 2;;
esac
if [[ $(wpctl get-volume @DEFAULT_AUDIO_SINK@) != *MUTED* ]]; then
 "$HOME/.local/bin/macos-sound" volume
fi

"$HOME/.local/bin/macos-osd" volume >/dev/null 2>&1 &
