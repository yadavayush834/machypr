#!/bin/sh
set -eu
if [ "$(id -u)" -ne 0 ]; then
    exec pkexec "$0" "$@"
fi
config=/etc/systemd/sleep.conf.d/90-fast-wake.conf
if [ "${1:-}" = --undo ]; then
    rm -f "$config"
    printf '%s\n' deep > /sys/power/mem_sleep
    echo 'Restored default sleep mode.'
    exit 0
fi
if [ -e "$config" ]; then
    cp -a "$config" "$config.backup-$(date +%Y%m%d-%H%M%S)"
fi
install -d -m 755 /etc/systemd/sleep.conf.d
printf '%s\n' '[Sleep]' '# Prefer faster resume; consumes more battery during sleep.' 'SuspendState=mem' 'MemorySleepMode=s2idle' > "$config"
chmod 644 "$config"
printf '%s\n' s2idle > /sys/power/mem_sleep
cat /sys/power/mem_sleep
echo 'Fast wake enabled now and for future suspends.'
