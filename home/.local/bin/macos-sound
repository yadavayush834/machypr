#!/usr/bin/env python3
"""Quiet, rate-limited system-effect playback; never change media volume."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import shutil
import subprocess
import time

HOME=Path.home()
def settings():
    try:return json.loads((HOME/'.config/macos-desktop/sounds.json').read_text())
    except (OSError,ValueError):return {'enabled':True,'volume':0.35}

def play(event):
    config=settings()
    if not config.get('enabled',True):return
    if event=='notification':
        if os.environ.get('DUNST_SUMMARY')=='Screenshot saved':return
        if os.environ.get('DUNST_URGENCY')=='CRITICAL':event='critical'
    path=HOME/'.local/share/sounds/MacDesktop/stereo'/(event+'.wav')
    if not path.exists():return
    runtime=Path(os.environ.get('XDG_RUNTIME_DIR',HOME/'.cache'))/'macos-desktop-sounds';runtime.mkdir(parents=True,exist_ok=True)
    with (runtime/'playback.lock').open('a+') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        stamp=runtime/(event+'.time')
        try:previous=float(stamp.read_text())
        except (OSError,ValueError):previous=0
        now=time.monotonic()
        if now-previous < (.12 if event=='volume' else .8):return
        stamp.write_text(str(now))
    volume=max(0,min(1,float(config.get('volume',.35))))
    if shutil.which('pw-play'):command=['pw-play','--volume',str(volume),str(path)]
    elif shutil.which('paplay'):command=['paplay','--volume='+str(round(65536*volume)),str(path)]
    else:return
    subprocess.Popen(command,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)

if __name__=='__main__':
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('event',choices=['notification','critical','volume','screenshot','on','off','status'])
    args=parser.parse_args()
    if args.event in ('on','off'):
        config=settings();config['enabled']=args.event=='on'
        path=HOME/'.config/macos-desktop/sounds.json';path.parent.mkdir(parents=True,exist_ok=True);path.write_text(json.dumps(config,indent=2)+'\n')
        if shutil.which('gsettings'):subprocess.run(['gsettings','set','org.gnome.desktop.sound','event-sounds','true' if config['enabled'] else 'false'],check=False)
    elif args.event=='status':print(json.dumps(settings()))
    else:play(args.event)
